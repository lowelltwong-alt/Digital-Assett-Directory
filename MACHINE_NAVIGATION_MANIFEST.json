{
  "manifest_version": "0.1.0",
  "project": "Digital-Assett-Directory",
  "status": "seed_scaffold",
  "purpose": "Local-first digital asset catalog, knowledge graph, orphan/activation/synergy radar, and governed learning hub.",
  "start_files": [
    "AI_FRONT_DOOR.md",
    "AGENTS.md",
    "registry/source-of-truth.json",
    "registry/design-authority.json",
    "registry/identity-layer-registry.json",
    "AI_TABLE_OF_CONTENTS.md"
  ],
  "navigation_standards": {
    "single_ai_entrypoint": "AI_FRONT_DOOR.md",
    "ai_table_of_contents": "AI_TABLE_OF_CONTENTS.md",
    "routing_standard": "docs/AI_ENTRYPOINT_AND_TOC_ROUTING_STANDARD.md",
    "toc_template": "templates/ai-table-of-contents.template.md"
  },
  "knowledge_graph_entrypoints": [
    "docs/KNOWLEDGE_GRAPH_MODEL.md",
    "ontology/digital-asset-ontology.ttl",
    "ontology/taxonomy.skos.ttl",
    "registry/edge-type-registry.json",
    "registry/asset-pattern-registry.json",
    "registry/context-tag-registry.json",
    "registry/template-registry.json",
    "docs/CROSS_REPO_GOVERNANCE_DEPENDENCY_MAP_PATTERN.md",
    "processed/graph/graph.json",
    "processed/reports/asset_family_recognition.md",
    "processed/reports/workflow_sweeps/workflow_sweeps_index.md",
    "processed/reports/workflow_part_recognition.md",
    "processed/reports/workflow_part_calibration_review_sample.md",
    "processed/reports/workflow_part_usage_guidance.md",
    "processed/reports/manual_task_queue.md",
    "processed/reports/repo_buildout/index.md",
    "processed/reports/template_library.md",
    "processed/reports/operational_readiness.md",
    "processed/reports/scan_coverage_cycle.md",
    "processed/learning/scan_cycle_events.jsonl",
    "processed/reports/lesson_automation_next_actions.md",
    "processed/learning/lesson_automation_action_decisions.jsonl",
    "processed/reports/lesson_automation_execution_plan.md",
    "processed/reports/repo_learning_loop_install_scope.md",
    "processed/reports/governance_map_adoption_scope.md",
    "processed/reports/ci_release_artifact_scope.md",
    "processed/reports/priority_content_extract_scope.md",
    "processed/learning/priority_content_observations.jsonl",
    "processed/learning/priority_content_lesson_candidates.jsonl",
    "processed/learning/learning_rule_promotion_candidates.jsonl"
  ],
  "registries": {
    "source_of_truth": "registry/source-of-truth.json",
    "design_authority": "registry/design-authority.json",
    "asset_types": "registry/asset-type-registry.json",
    "asset_patterns": "registry/asset-pattern-registry.json",
    "context_tags": "registry/context-tag-registry.json",
    "workflow_part_types": "registry/workflow-part-type-registry.json",
    "learning_rules": "registry/learning-rule-registry.json",
    "semantic_evolution_grades": "registry/semantic-evolution-grade-registry.json",
    "identity_layers": "registry/identity-layer-registry.json",
    "edge_types": "registry/edge-type-registry.json",
    "lifecycle": "registry/lifecycle-registry.json",
    "templates": "registry/template-registry.json",
    "schemas": "registry/schema-registry.json",
    "priority_content_lesson_review_schema": "schemas/priority-content-lesson-review.schema.json",
    "learning_rule_promotion_candidate_schema": "schemas/learning-rule-promotion-candidate.schema.json",
    "scan_cycle_event_schema": "schemas/scan-cycle-event.schema.json",
    "capabilities": "registry/capability-registry.json",
    "needs": "registry/need-registry.json",
    "data_dictionary": "docs/DATA_DICTIONARY.md",
    "lesson_automation_coverage": "docs/LESSON_AUTOMATION_COVERAGE.md"
  },
  "generated_surfaces": [
    "raw/",
    "processed/",
    "processed/learning/",
    "state/catalog.sqlite3",
    "audit/events/"
  ],
  "safe_default": "read_only_scan",
  "forbidden_default_actions": [
    "source_mutation",
    "secret_storage",
    "automatic_canon_promotion",
    "automatic_external_code_merge"
  ],
  "validation": [
    "python -m pytest",
    "python -m digital_asset_directory.cli validate",
    "python -m digital_asset_directory.cli roadmap check"
  ]
}
