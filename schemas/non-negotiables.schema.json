{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.digital-asset-directory/schemas/non-negotiables.schema.json",
  "title": "DAD Non-Negotiables Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "authority_boundary", "non_negotiables"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "registry_id": {"type": "string", "minLength": 1},
    "authority_boundary": {"type": "string", "minLength": 1},
    "non_negotiables": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "rule", "severity", "source_ref"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "rule": {"type": "string", "minLength": 1},
          "severity": {"enum": ["warning", "stop", "hard_gate"]},
          "source_ref": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
