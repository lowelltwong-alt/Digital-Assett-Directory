{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.digital-asset-directory/schemas/preflight-profile-router.schema.json",
  "title": "Preflight Profile Router",
  "type": "object",
  "required": [
    "router_version",
    "status",
    "authority_boundary",
    "default_route",
    "routes"
  ],
  "properties": {
    "router_version": {"const": "0.1.0"},
    "status": {"type": "string", "minLength": 1},
    "authority_boundary": {"type": "string", "minLength": 1},
    "default_route": {"type": "string", "minLength": 1},
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "route_id",
          "task_context",
          "match",
          "required_preflight_profiles",
          "optional_tactic_bundles",
          "recommended_tactic_ids",
          "validation_expectations",
          "authority_boundary",
          "stop_conditions"
        ],
        "properties": {
          "route_id": {"type": "string", "minLength": 1},
          "task_context": {"type": "string", "minLength": 1},
          "match": {
            "type": "object",
            "required": ["task_types", "languages", "risk_tags", "repo_types"],
            "properties": {
              "task_types": {"type": "array", "items": {"type": "string"}},
              "languages": {"type": "array", "items": {"type": "string"}},
              "risk_tags": {"type": "array", "items": {"type": "string"}},
              "repo_types": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          },
          "required_preflight_profiles": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "optional_tactic_bundles": {"type": "array", "items": {"type": "string"}},
          "recommended_tactic_ids": {"type": "array", "items": {"type": "string"}},
          "validation_expectations": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "authority_boundary": {"type": "string", "minLength": 1},
          "stop_conditions": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
