{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.digital-asset-directory/schemas/ai-navigation-registry.schema.json",
  "title": "AI Navigation Registry",
  "type": "object",
  "required": [
    "schema_version",
    "registry_id",
    "navigation_version",
    "updated_at",
    "singular_entrypoint",
    "entrypoint_policy",
    "branch_depth_policy",
    "freshness_policy",
    "change_classes",
    "branch_map",
    "recent_changes",
    "authority_boundary"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "registry_id": {"const": "ai-navigation-registry"},
    "navigation_version": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]+$"
    },
    "updated_at": {"type": "string", "minLength": 10},
    "singular_entrypoint": {
      "type": "object",
      "required": ["path", "rule", "competing_entrypoints_policy"],
      "properties": {
        "path": {"const": "AI_FRONT_DOOR.md"},
        "rule": {"type": "string", "minLength": 1},
        "competing_entrypoints_policy": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "entrypoint_policy": {
      "type": "object",
      "required": ["start_rule", "memory_rule", "branch_rule", "mailbox_rule"],
      "properties": {
        "start_rule": {"type": "string", "minLength": 1},
        "memory_rule": {"type": "string", "minLength": 1},
        "branch_rule": {"type": "string", "minLength": 1},
        "mailbox_rule": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "branch_depth_policy": {
      "type": "object",
      "required": ["max_default_hops", "rule", "anti_bloat_rule"],
      "properties": {
        "max_default_hops": {"type": "integer", "minimum": 1, "maximum": 5},
        "rule": {"type": "string", "minLength": 1},
        "anti_bloat_rule": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "freshness_policy": {
      "type": "object",
      "required": [
        "version_check",
        "date_policy",
        "recent_changes_limit",
        "stale_memory_action",
        "toc_row_policy"
      ],
      "properties": {
        "version_check": {"type": "string", "minLength": 1},
        "date_policy": {"type": "string", "minLength": 1},
        "recent_changes_limit": {"type": "integer", "minimum": 1, "maximum": 50},
        "stale_memory_action": {"type": "string", "minLength": 1},
        "toc_row_policy": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "change_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["change_class", "meaning", "agent_action"],
        "properties": {
          "change_class": {"type": "string", "minLength": 1},
          "meaning": {"type": "string", "minLength": 1},
          "agent_action": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "branch_map": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "branch_id",
          "path",
          "role",
          "tags",
          "use_when",
          "current_version",
          "last_material_change_at",
          "change_class",
          "route_after",
          "freshness_hint"
        ],
        "properties": {
          "branch_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "tags": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1
          },
          "use_when": {"type": "string", "minLength": 1},
          "current_version": {"type": "string", "minLength": 1},
          "last_material_change_at": {"type": "string", "minLength": 10},
          "change_class": {"type": "string", "minLength": 1},
          "route_after": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "freshness_hint": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "recent_changes": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "change_id",
          "changed_at",
          "change_type",
          "paths",
          "summary",
          "agent_action",
          "route_tags"
        ],
        "properties": {
          "change_id": {"type": "string", "minLength": 1},
          "changed_at": {"type": "string", "minLength": 10},
          "change_type": {"type": "string", "minLength": 1},
          "paths": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1
          },
          "summary": {"type": "string", "minLength": 1},
          "agent_action": {"type": "string", "minLength": 1},
          "route_tags": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    "authority_boundary": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
