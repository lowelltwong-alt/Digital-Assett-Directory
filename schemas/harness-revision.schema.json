{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dad.local/schemas/harness-revision-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "harness_id", "revision_id", "version", "content_digest", "predecessor_revision_id", "lifecycle_state", "applicability_tags", "runtime_requirements", "dependencies", "fresh_until", "commands", "positive_cases", "negative_cases", "failure_recovery_cases", "provenance_refs", "rollback", "review_evidence", "candidate_only"],
  "properties": {
    "schema_version": {"const": "dad.harness_revision.v1"},
    "harness_id": {"type": "string", "pattern": "^harness:"},
    "revision_id": {"type": "string", "pattern": "^harness-revision:"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "predecessor_revision_id": {"type": "string"},
    "lifecycle_state": {"enum": ["discovered", "candidate", "shadow", "piloted", "reviewed_active", "watch", "stale", "superseded", "retired", "rejected"]},
    "applicability_tags": {"$ref": "#/$defs/strings"},
    "runtime_requirements": {"type": "object"},
    "dependencies": {"$ref": "#/$defs/strings"},
    "fresh_until": {"type": "string", "format": "date-time"},
    "commands": {"type": "array", "items": {"$ref": "#/$defs/command"}},
    "positive_cases": {"$ref": "#/$defs/strings"},
    "negative_cases": {"$ref": "#/$defs/strings"},
    "failure_recovery_cases": {"$ref": "#/$defs/strings"},
    "provenance_refs": {"$ref": "#/$defs/strings"},
    "rollback": {"type": "string", "minLength": 1},
    "review_evidence": {"$ref": "#/$defs/strings"},
    "candidate_only": {"const": true}
  },
  "$defs": {
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "command": {"type": "object", "additionalProperties": false, "required": ["command_id", "argv", "cwd_policy", "timeout_seconds", "effect_class", "required_tool_capabilities", "allowed_environment_keys"], "properties": {"command_id": {"type": "string", "minLength": 1}, "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "cwd_policy": {"enum": ["target_repo", "harness_package"]}, "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 120}, "effect_class": {"enum": ["read_only", "local_build_artifact"]}, "required_tool_capabilities": {"$ref": "#/$defs/strings"}, "allowed_environment_keys": {"$ref": "#/$defs/strings"}}}
  }
}
