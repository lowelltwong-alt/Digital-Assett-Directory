{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dad.local/schemas/exception-event-type-registry.schema.json",
  "title": "DAD Exception Event Type Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "taxonomy_dimensions", "event_types", "backfill_classifier"],
  "properties": {
    "registry_version": { "type": "string" },
    "taxonomy_dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["methodology_version", "authority_boundary", "axes", "category_defaults"],
      "properties": {
        "methodology_version": { "type": "string", "minLength": 1 },
        "authority_boundary": { "type": "string", "minLength": 1 },
        "axes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description", "values"],
            "properties": {
              "description": { "type": "string", "minLength": 1 },
              "values": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "category_defaults": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "origin_surface",
              "detection_mode",
              "impact_domain",
              "learning_route",
              "default_handling",
              "review_priority"
            ],
            "properties": {
              "origin_surface": { "type": "string", "minLength": 1 },
              "detection_mode": { "type": "string", "minLength": 1 },
              "impact_domain": { "type": "string", "minLength": 1 },
              "learning_route": { "type": "string", "minLength": 1 },
              "default_handling": { "type": "string", "minLength": 1 },
              "review_priority": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "event_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_type",
          "category",
          "description",
          "capture_contracts",
          "default_severity",
          "sensitivity_default",
          "learnable",
          "examples",
          "required_context_refs",
          "never_collect",
          "review_status"
        ],
        "properties": {
          "event_type": { "type": "string", "minLength": 1 },
          "category": {
            "type": "string",
            "enum": [
              "command",
              "test",
              "ci",
              "runtime",
              "schema_config",
              "mail_enrollment",
              "governance",
              "public_private",
              "security_privacy",
              "environment_tooling",
              "external_service",
              "data_ingestion",
              "identity_resolution",
              "release_packaging",
              "review",
              "agent_behavior",
              "dad_recommendation",
              "data_integrity",
              "dependency_io",
              "code_change",
              "repo_state",
              "roadmap_validation",
              "harness_parity",
              "backfill_candidate",
              "other"
            ]
          },
          "description": { "type": "string", "minLength": 1 },
          "capture_contracts": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "failed_command",
                "retry_or_plan_change",
                "postflight_exception",
                "ci_failure",
                "governance_block",
                "review_finding",
                "fix_outcome",
                "dad_recommendation_outcome",
                "backfill_candidate"
              ]
            }
          },
          "default_severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
          "sensitivity_default": {
            "type": "string",
            "enum": ["public_safe", "internal", "private", "restricted", "unknown"]
          },
          "learnable": { "type": "boolean" },
          "examples": { "type": "array", "items": { "type": "string" } },
          "required_context_refs": { "type": "array", "items": { "type": "string" } },
          "never_collect": { "type": "array", "items": { "type": "string" } },
          "review_status": { "type": "string", "enum": ["candidate", "reviewed", "deprecated"] }
        }
      }
    },
    "backfill_classifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "methodology_version",
        "authority_boundary",
        "rules"
      ],
      "properties": {
        "methodology_version": { "type": "string", "minLength": 1 },
        "authority_boundary": { "type": "string", "minLength": 1 },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule_id",
              "terms",
              "event_type",
              "severity",
              "capture_contract",
              "classification_confidence",
              "false_positive_risk",
              "applies_when",
              "does_not_apply_when"
            ],
            "properties": {
              "rule_id": { "type": "string", "pattern": "^backfill-rule:" },
              "terms": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "event_type": { "type": "string", "minLength": 1 },
              "severity": {
                "type": "string",
                "enum": ["critical", "high", "medium", "low", "info"]
              },
              "capture_contract": {
                "type": "string",
                "enum": [
                  "failed_command",
                  "retry_or_plan_change",
                  "postflight_exception",
                  "ci_failure",
                  "governance_block",
                  "review_finding",
                  "fix_outcome",
                  "dad_recommendation_outcome",
                  "backfill_candidate"
                ]
              },
              "classification_confidence": {
                "type": "string",
                "enum": ["path_name_signal_only"]
              },
              "false_positive_risk": { "type": "string", "minLength": 1 },
              "applies_when": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "does_not_apply_when": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
