{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.digital-asset-directory/schemas/language-coding-advantage-registry.schema.json",
  "title": "DAD Language Coding Advantage Registry",
  "type": "object",
  "required": [
    "schema_version",
    "registry_id",
    "authority_boundary",
    "evidence_methodology",
    "languages"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "registry_id": {"const": "language-coding-advantage-registry"},
    "authority_boundary": {"type": "string", "minLength": 1},
    "evidence_methodology": {"type": "string", "minLength": 1},
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "language_id",
          "label",
          "status",
          "primary_assets",
          "trusted_source_ids",
          "check_cadence",
          "frontier_questions",
          "ai_advantages",
          "ai_overlooked_patterns",
          "harness_routes",
          "validation_gates",
          "adoption_rules",
          "anti_patterns",
          "research_intake_packet",
          "review_status",
          "last_reviewed_at",
          "next_review_due_at"
        ],
        "additionalProperties": false,
        "properties": {
          "language_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "label": {"type": "string", "minLength": 1},
          "status": {
            "enum": [
              "installed_for_local_reuse",
              "candidate",
              "template",
              "deprecated"
            ]
          },
          "primary_assets": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "trusted_source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
          },
          "check_cadence": {"enum": ["weekly", "monthly", "quarterly", "manual"]},
          "frontier_questions": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "ai_advantages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "advantage_id",
                "summary",
                "use_when",
                "avoid_when",
                "verification"
              ],
              "additionalProperties": false,
              "properties": {
                "advantage_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9:-]*$"},
                "summary": {"type": "string", "minLength": 1},
                "use_when": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
                "avoid_when": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
                "verification": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
              }
            }
          },
          "ai_overlooked_patterns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "pattern_id",
                "summary",
                "why_ai_may_miss_it",
                "detection_signals",
                "route_to"
              ],
              "additionalProperties": false,
              "properties": {
                "pattern_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9:-]*$"},
                "summary": {"type": "string", "minLength": 1},
                "why_ai_may_miss_it": {"type": "string", "minLength": 1},
                "detection_signals": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
                "route_to": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
              }
            }
          },
          "harness_routes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["harness_id", "use_when", "evidence_required"],
              "additionalProperties": false,
              "properties": {
                "harness_id": {"type": "string", "minLength": 1},
                "use_when": {"type": "string", "minLength": 1},
                "evidence_required": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
              }
            }
          },
          "validation_gates": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "adoption_rules": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "anti_patterns": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "research_intake_packet": {
            "type": "object",
            "required": ["message_type", "dad_need_id", "required_fields", "forbidden_fields"],
            "additionalProperties": false,
            "properties": {
              "message_type": {"enum": ["capability_suggestion", "asset_suggestion", "workflow_suggestion", "lesson_suggestion"]},
              "dad_need_id": {"type": "string", "minLength": 1},
              "required_fields": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
              "forbidden_fields": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
            }
          },
          "review_status": {"enum": ["candidate", "reviewed", "installed_for_local_reuse", "deprecated"]},
          "last_reviewed_at": {"type": "string", "minLength": 1},
          "next_review_due_at": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
