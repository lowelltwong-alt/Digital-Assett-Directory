            "minItems": 1,
            "uniqueItems": true
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "next_action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      },
      "maxItems": 3
    },
    "workstream_cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "card_id",
          "workstream_id",
          "label",
          "lifecycle_state",
          "accepted_specific_resource_ids",
          "case_ids",
          "missing_exact_scope"
        ],
        "properties": {
          "card_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "workstream_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "lifecycle_state": {
            "type": "string",
            "enum": [
              "proposed",
              "active"
            ]
          },
          "accepted_specific_resource_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "uniqueItems": true
          },
          "case_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "uniqueItems": true
          },
          "missing_exact_scope": {
            "type": "boolean"
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "revision_id",
          "case_kind",
          "evidence_tier",
          "disposition",
          "label",
          "subject_workstream_ids",
          "subject_resource_ids",
          "source_attention_ids",
          "source_bundle_ids",
          "signals",
          "counterevidence",
          "evidence_summary",
          "choices"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "revision_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "case_kind": {
            "type": "string",
            "enum": [
              "split",
              "rescope",
              "possible_duplicate",
              "recovery"
            ]
          },
          "evidence_tier": {
            "type": "string",
            "enum": [
              "PD0_shared_exact_specific_resource",
              "PD1_reciprocal_exact_pair_split_between_workstreams",
              "PD2_similarity_only",
              "SP0_disconnected_exact_owned_components",
              "RS0_exact_contextual_unassigned_bundle",
              "RS1_repo_context_only",
              "RC0_integrity_unknown_attention",
              "RC1_dirty_exact_attention",
              "RC2_existing_workstream_trigger",
              "RC3_unassigned_observed_bundle"
            ]
          },
          "disposition": {
            "type": "string",
            "enum": [
              "review",
              "inspect_only",
              "blocked"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "subject_workstream_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "uniqueItems": true
          },
          "subject_resource_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "uniqueItems": true
          },
          "source_attention_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "uniqueItems": true
          },
          "source_bundle_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "uniqueItems": true
          },
          "signals": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "uniqueItems": true
          },
          "counterevidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "uniqueItems": true
          },
          "evidence_summary": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "exact_component_count",
              "project_count",
              "shared_specific_resource_count",
              "shared_token_count",
              "shared_token_hashes",
              "attention_bands",
              "trigger_kinds",
              "context_basis"
            ],
            "properties": {
              "exact_component_count": {
                "type": "integer",
                "minimum": 0
              },
              "project_count": {
                "type": "integer",
                "minimum": 0
              },
              "shared_specific_resource_count": {
                "type": "integer",
                "minimum": 0
              },
              "shared_token_count": {
                "type": "integer",
                "minimum": 0
              },
              "shared_token_hashes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "uniqueItems": true
              },
              "attention_bands": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "uniqueItems": true
              },
              "trigger_kinds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "uniqueItems": true
              },
              "context_basis": {
                "type": "string",
                "enum": [
                  "none",
                  "accepted_exact_collision",
                  "reciprocal_exact_pair",
                  "similarity_only",
                  "accepted_exact_components",
                  "exact_attention_assignment",
                  "repo_context_only",
                  "unassigned_exact_bundle",
                  "accepted_attention_join",
                  "observed_attention"
                ]
              }
            }
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "choice_id",
                "choice_kind",
                "label",
                "effect_preview",
                "execution_available",
                "requires_human_decision"
              ],
              "properties": {
                "choice_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "choice_kind": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "effect_preview": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "execution_available": {
                  "const": false
                },
                "requires_human_decision": {
                  "const": true
                }
              }
            },
            "minItems": 2,
            "maxItems": 5
          }
        }
      },
      "maxItems": 500
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_workstream_ids",
        "source_resource_ids",
        "source_attention_ids",
        "source_bundle_ids",
        "today_attention_ids",
        "quiet_workstream_ids",
        "terminal_workstream_ids",
        "workstreams_without_exact_bindings",
        "label_pair_count",
        "unevaluated_label_pair_count",
        "exact_context_bundle_count",
        "repo_context_bundle_count",
        "unassigned_bundle_count",
        "source_case_count",
        "cases_truncated_count",
        "typed_relation_evidence_available"
      ],
      "properties": {
        "eligible_workstream_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "uniqueItems": true
        },
        "source_resource_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "uniqueItems": true
        },
        "source_attention_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "uniqueItems": true
        },
        "source_bundle_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "uniqueItems": true
        },
        "today_attention_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "uniqueItems": true
        },
        "quiet_workstream_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "uniqueItems": true
        },
        "terminal_workstream_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "uniqueItems": true
        },
        "workstreams_without_exact_bindings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "uniqueItems": true
        },
        "label_pair_count": {
          "type": "integer",
          "minimum": 0
        },
        "unevaluated_label_pair_count": {
          "type": "integer",
          "minimum": 0
        },
        "exact_context_bundle_count": {
          "type": "integer",
          "minimum": 0
        },
        "repo_context_bundle_count": {
          "type": "integer",
          "minimum": 0
        },
        "unassigned_bundle_count": {
          "type": "integer",
          "minimum": 0
        },
        "source_case_count": {
          "type": "integer",
          "minimum": 0
        },
        "cases_truncated_count": {
          "type": "integer",
          "minimum": 0
        },
        "typed_relation_evidence_available": {
          "const": false
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref",
          "note"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "ref": {
            "type": "string",
            "maxLength": 1000
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "kind",
          "ref",
          "note",
          "severity"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "ref": {
            "type": "string",
            "maxLength": 1000
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "danger"
            ]
          }
        }
      }
    },
    "source_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workstreams",
        "cockpit",
        "reconciliation"
      ],
      "properties": {
        "workstreams": {
          "type": "string",
          "maxLength": 200
        },
        "cockpit": {
          "type": "string",
          "maxLength": 200
        },
        "reconciliation": {
          "type": "string",
          "maxLength": 200
        }
      }
    }
  }
}
