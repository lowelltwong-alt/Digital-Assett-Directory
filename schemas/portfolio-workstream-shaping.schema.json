        "review_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "fresh_after_hours": {
          "type": "integer",
          "minimum": 1
        },
        "future_tolerance_hours": {
          "type": "integer",
          "minimum": 0
