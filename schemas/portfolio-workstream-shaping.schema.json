          "const": "dad.portfolio-workstream-shaping.v1"
        },
        "methodology_ref": {
          "const": "docs/frontier/collaboration/13_PORTFOLIO_WORKSTREAM_SHAPING.md"
        },
        "case_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
