        "cockpit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "status",
            "freshness",
            "schema_version",
            "generated_at",
            "source_hash",
            "problems"
          ],
          "properties": {
            "name": {
              "type": "string",
              "enum": [
                "workstreams",
                "cockpit",
                "reconciliation"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "observed",
                "invalid",
                "unavailable"
              ]
            },
            "freshness": {
              "type": "string",
              "enum": [
                "current",
                "stale",
                "future",
                "unknown"
              ]
            },
            "schema_version": {
              "type": "string",
              "maxLength": 100
            },
            "generated_at": {
              "type": "string",
              "maxLength": 100
            },
            "source_hash": {
              "type": "string",
              "maxLength": 200
            },
            "problems": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "uniqueItems": true
            }
          }
        },
        "reconciliation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "status",
            "freshness",
            "schema_version",
            "generated_at",
            "source_hash",
            "problems"
          ],
          "properties": {
            "name": {
              "type": "string",
              "enum": [
                "workstreams",
                "cockpit",
                "reconciliation"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "observed",
                "invalid",
                "unavailable"
              ]
            },
            "freshness": {
              "type": "string",
              "enum": [
                "current",
                "stale",
                "future",
                "unknown"
              ]
            },
            "schema_version": {
              "type": "string",
              "maxLength": 100
            },
            "generated_at": {
              "type": "string",
              "maxLength": 100
            },
            "source_hash": {
              "type": "string",
              "maxLength": 200
            },
            "problems": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "source_coupling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workstreams_to_cockpit",
        "cockpit_to_reconciliation",
        "reconciliation_fully_reconciled"
      ],
      "properties": {
        "workstreams_to_cockpit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actual_source_hash",
            "claimed_source_hash",
            "matches"
