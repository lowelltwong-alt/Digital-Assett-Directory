          "properties": {
            "actual_source_hash": {
              "type": "string",
              "maxLength": 200
            },
            "claimed_source_hash": {
              "type": "string",
              "maxLength": 200
            },
            "matches": {
              "type": "boolean"
            }
          }
        },
        "cockpit_to_reconciliation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actual_source_hash",
            "claimed_source_hash",
            "matches"
          ],
          "properties": {
            "actual_source_hash": {
              "type": "string",
              "maxLength": 200
            },
            "claimed_source_hash": {
              "type": "string",
              "maxLength": 200
            },
            "matches": {
              "type": "boolean"
            }
          }
        },
        "reconciliation_fully_reconciled": {
          "type": "boolean"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workstream_count",
        "eligible_workstream_count",
        "case_count",
        "hidden_case_count",
        "split_case_count",
        "rescope_case_count",
        "possible_duplicate_case_count",
        "recovery_case_count",
        "review_count",
        "blocker_count",
        "unknown_count",
        "shaping_complete",
        "intake_needed",
        "no_cases_generated"
      ],
      "properties": {
        "workstream_count": {
          "type": "integer",
          "minimum": 0
        },
        "eligible_workstream_count": {
          "type": "integer",
          "minimum": 0
        },
        "case_count": {
          "type": "integer",
          "minimum": 0
        },
        "hidden_case_count": {
          "type": "integer",
          "minimum": 0
        },
        "split_case_count": {
          "type": "integer",
          "minimum": 0
        },
        "rescope_case_count": {
          "type": "integer",
          "minimum": 0
        },
        "possible_duplicate_case_count": {
          "type": "integer",
          "minimum": 0
        },
        "recovery_case_count": {
          "type": "integer",
          "minimum": 0
        },
        "review_count": {
          "type": "integer",
          "minimum": 0
        },
        "blocker_count": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_count": {
          "type": "integer",
          "minimum": 0
        },
        "shaping_complete": {
          "type": "boolean"
        },
        "intake_needed": {
          "type": "boolean"
        },
        "no_cases_generated": {
          "type": "boolean"
        }
      }
    },
    "review_queue": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "review_id",
          "case_id",
          "case_kind",
          "evidence_tier",
          "attention_ids",
          "label",
          "next_action"
        ],
        "properties": {
          "review_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "case_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "case_kind": {
            "type": "string",
            "enum": [
              "split",
              "rescope",
              "possible_duplicate",
              "recovery"
            ]
          },
          "evidence_tier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "attention_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
