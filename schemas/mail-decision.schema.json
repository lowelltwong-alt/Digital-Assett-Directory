{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.digital-asset-directory/schemas/mail-decision.schema.json",
  "title": "Mail Decision Record",
  "type": "object",
  "required": [
    "schema_version",
    "decision_id",
    "mail_id",
    "repository",
    "decision",
    "decided_at",
    "decided_by",
    "notes",
    "review_status"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "decision_id": {"type": "string", "minLength": 1},
    "mail_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "decision": {"enum": ["accept", "defer", "reject", "archive"]},
    "decided_at": {"type": "string", "minLength": 1},
    "decided_by": {"type": "string"},
    "notes": {"type": "string"},
    "review_status": {"const": "reviewed"}
  },
  "additionalProperties": false
}
