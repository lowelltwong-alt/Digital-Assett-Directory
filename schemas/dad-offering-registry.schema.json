{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.digital-asset-directory/schemas/dad-offering-registry.schema.json",
  "title": "DAD Offerings Registry",
  "type": "object",
  "required": ["schema_version", "registry_id", "authority_boundary", "offerings"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "registry_id": {"type": "string", "minLength": 1},
    "authority_boundary": {"type": "string", "minLength": 1},
    "offerings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "offering_id",
          "name",
          "version",
          "offering_type",
          "path",
          "languages",
          "repo_types",
          "domains",
          "context_tags",
          "task_types",
          "capabilities",
          "applies_when",
          "does_not_apply_when",
          "public_safe",
          "upgrade_channel",
          "known_upgrades",
          "source_refs",
          "review_status",
          "authority_boundary"
        ],
        "properties": {
          "offering_id": {"type": "string", "pattern": "^dad:offering:[a-z0-9][a-z0-9:-]*$"},
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "offering_type": {
            "enum": [
              "asset",
              "skill",
              "template",
              "harness",
              "architecture_ref",
              "governance_map",
              "data_map",
              "workflow",
              "control_plane",
              "best_practice"
            ]
          },
          "path": {"type": "string", "minLength": 1},
          "languages": {"type": "array", "items": {"type": "string"}},
          "repo_types": {"type": "array", "items": {"type": "string"}},
          "domains": {"type": "array", "items": {"type": "string"}},
          "context_tags": {"type": "array", "items": {"type": "string"}},
          "task_types": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "capabilities": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "applies_when": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "does_not_apply_when": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "public_safe": {"type": "boolean"},
          "upgrade_channel": {"enum": ["dad_mail", "manual_review", "none"]},
          "known_upgrades": {"type": "array", "items": {"type": "object"}},
          "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "harness_registry_ref": {"type": "string", "minLength": 1},
          "review_status": {"enum": ["candidate", "reviewed", "installed_for_local_reuse", "deprecated", "rejected"]},
          "authority_boundary": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
