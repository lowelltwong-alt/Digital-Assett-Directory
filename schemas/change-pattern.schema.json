{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.digital-asset-directory/schemas/change-pattern.schema.json",
  "title": "Change Pattern Record",
  "type": "object",
  "required": [
    "schema_version",
    "change_pattern_id",
    "pattern_type",
    "asset_ids",
    "paths",
    "summary",
    "evidence",
    "context_tags",
    "confidence",
    "risk",
    "generated_at",
    "scan_id",
    "review_status"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "change_pattern_id": {"type": "string", "minLength": 1},
    "pattern_type": {"enum": ["co_change", "repeated_edit", "variant_file", "late_stabilizer", "changelog_theme"]},
    "asset_ids": {"type": "array", "items": {"type": "string"}},
    "paths": {"type": "array", "items": {"type": "string"}},
    "summary": {"type": "string", "minLength": 1},
    "evidence": {"type": "object", "minProperties": 1},
    "context_tags": {"type": "array", "items": {"type": "string"}},
    "confidence": {"enum": ["low", "medium", "high"]},
    "risk": {"enum": ["low", "medium", "high"]},
    "generated_at": {"type": "string"},
    "scan_id": {"type": "string", "minLength": 1},
    "review_status": {"enum": ["generated_candidate", "reviewed", "rejected"]}
  },
  "additionalProperties": false
}
