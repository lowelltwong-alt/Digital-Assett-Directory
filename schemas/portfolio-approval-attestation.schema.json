{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dad://schemas/portfolio-approval-attestation.v1",
  "title": "DAD Portfolio Approval Attestation",
  "description": "One domain-separated Ed25519 signature over a fixed printable-string claim and the complete authority-event digest. Schema conformance is not verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority_context",
    "signature_algorithm",
    "canonicalization",
    "digest_algorithm",
    "audience",
    "execution_mode",
    "trust_registry_digest",
    "attestation_id",
    "approval_id",
    "authority_domain",
    "event_id",
    "event_kind",
    "event_digest",
    "event_schema_version",
    "stream_id",
    "prev_event_id",
    "command_id",
    "event_recorded_at",
    "key_id",
    "approver_id",
    "issued_at",
    "not_before",
    "expires_at",
    "nonce",
    "signature"
  ],
  "properties": {
    "schema_version": {"const": "dad.portfolio_approval_attestation.v1"},
    "authority_context": {"const": "dad.portfolio_execution_authority.v1"},
    "signature_algorithm": {"const": "ed25519"},
    "canonicalization": {"const": "dad-ascii-json.v1"},
    "digest_algorithm": {"const": "sha256"},
    "audience": {"const": "dad.portfolio.execution-control"},
    "execution_mode": {"const": "dry_run"},
    "trust_registry_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "attestation_id": {"type": "string", "pattern": "^dad:portfolio-attestation:[0-9a-f-]{36}$"},
    "approval_id": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[\\x21-\\x7e]+$"},
    "authority_domain": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "event_id": {"type": "string", "pattern": "^dad:portfolio-event:[0-9a-f-]{36}$"},
    "event_kind": {"enum": ["execution_lease_granted", "dispatch_intent_approved", "dispatch_reconciliation_recorded"]},
    "event_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "event_schema_version": {"const": "dad.portfolio_execution_control_event.v1"},
    "stream_id": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[\\x21-\\x7e]+$"},
    "prev_event_id": {"type": "string", "pattern": "^$|^dad:portfolio-event:[0-9a-f-]{36}$"},
    "command_id": {"type": "string", "pattern": "^dad:portfolio-command:[0-9a-f-]{36}$"},
    "event_recorded_at": {"type": "string", "format": "date-time"},
    "key_id": {"type": "string", "pattern": "^dad:portfolio-approval-key:[0-9a-f]{64}$"},
    "approver_id": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[\\x21-\\x7e]+$"},
    "issued_at": {"type": "string", "format": "date-time"},
    "not_before": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "nonce": {"type": "string", "minLength": 16, "maxLength": 128, "pattern": "^[\\x21-\\x7e]+$"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
  }
}
