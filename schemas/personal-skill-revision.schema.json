{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://local.digital-asset-directory/schemas/personal-skill-revision.schema.json", "title": "Personal Skill Archive Revision", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "revision_id", "skill_id", "artifact_role", "tree_sha256", "archived_at", "source_runtime", "source_relative_path", "source_absolute_path_hint", "source_manifest_id", "source_manifest_sha256", "run_id", "local_paths_private", "files", "status", "validation_status", "review_status", "authority_boundary"],
  "properties": {
    "schema_version": {"const": "dad.personal-skills.v1"}, "revision_id": {"type": "string", "pattern": "^dad:personal-skill-revision:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}, "skill_id": {"type": "string", "pattern": "^personal-skill:[a-z0-9][a-z0-9-]*$"}, "artifact_role": {"const": "source_snapshot"}, "tree_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "archived_at": {"type": "string", "minLength": 1}, "source_runtime": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}, "source_relative_path": {"type": "string", "minLength": 1}, "source_absolute_path_hint": {"type": "string", "minLength": 1}, "source_manifest_id": {"const": "global-personal-skills-gpt"}, "source_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "run_id": {"type": "string", "pattern": "^dad:personal-skill-run:"}, "local_paths_private": {"const": true}, "status": {"const": "archived"}, "validation_status": {"const": "safe_snapshot"}, "review_status": {"const": "source_observation"}, "authority_boundary": {"type": "string", "minLength": 1},
    "files": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["relative_path", "blob_sha256", "size", "role"], "properties": {"relative_path": {"type": "string", "minLength": 1}, "blob_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "size": {"type": "integer", "minimum": 0}, "role": {"enum": ["portable_procedure", "runtime_adapter"]}}}}
  }
}
