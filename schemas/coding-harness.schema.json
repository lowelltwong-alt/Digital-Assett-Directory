{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.digital-asset-directory/schemas/coding-harness.schema.json",
  "title": "Coding Harness Record",
  "type": "object",
  "required": [
    "harness_id",
    "name",
    "version",
    "path",
    "family",
    "status",
    "languages",
    "repo_types",
    "domains",
    "context_tags",
    "task_types",
    "capabilities",
    "public_safe",
    "entrypoints",
    "research_questions",
    "validation_commands",
    "source_evidence",
    "review_status",
    "authority_boundary"
  ],
  "properties": {
    "harness_id": {"type": "string", "pattern": "^dad:harness:[a-z0-9][a-z0-9:-]*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "path": {"type": "string", "minLength": 1},
    "family": {"type": "string", "minLength": 1},
    "status": {"enum": ["candidate", "active", "deprecated", "retired"]},
    "languages": {"type": "array", "items": {"type": "string"}},
    "repo_types": {"type": "array", "items": {"type": "string"}},
    "domains": {"type": "array", "items": {"type": "string"}},
    "context_tags": {"type": "array", "items": {"type": "string"}},
    "task_types": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "capabilities": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "public_safe": {"type": "boolean"},
    "entrypoints": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "research_questions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "validation_commands": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "source_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "review_status": {"enum": ["candidate", "reviewed", "rejected"]},
    "authority_boundary": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
