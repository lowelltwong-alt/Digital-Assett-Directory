{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.digital-asset-directory/schemas/subagent-improvement-policy.schema.json",
  "title": "Subagent Improvement Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "policy_version", "status", "observation_cadence",
    "trend_review_cadence", "review_topology", "model_routes", "external_escalation", "thresholds", "exception_policy",
    "instruction_change_policy", "authority_boundary"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["candidate", "reviewed", "active"]},
    "observation_cadence": {"type": "string", "minLength": 1},
    "trend_review_cadence": {"type": "string", "minLength": 1},
    "review_topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "rule", "escalation_semantics"],
      "properties": {
        "mode": {"const": "bidirectional_peer_mesh"},
        "rule": {"type": "string", "minLength": 1},
        "escalation_semantics": {"type": "string", "minLength": 1}
      }
    },
    "model_routes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observer", "independent_judge", "routing_auditor", "codex_adjudicator", "instruction_improver"],
      "properties": {
        "observer": {"$ref": "#/$defs/route"},
        "independent_judge": {"$ref": "#/$defs/route"},
        "routing_auditor": {"$ref": "#/$defs/route"},
        "codex_adjudicator": {"$ref": "#/$defs/route"},
        "instruction_improver": {"$ref": "#/$defs/route"}
      }
    },
    "external_escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "manual_copy_only", "auto_send", "requires_prior_codex_adjudication", "triggers", "prompt_template", "privacy_boundary", "human_authority"],
      "properties": {
        "target": {"const": "fable_5_master_architect"},
        "manual_copy_only": {"const": true},
        "auto_send": {"const": false},
        "requires_prior_codex_adjudication": {"const": true},
        "triggers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "prompt_template": {"type": "string", "minLength": 1},
        "privacy_boundary": {"type": "string", "minLength": 1},
        "human_authority": {"type": "string", "minLength": 1}
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "self_independent_delta_points", "calibration_mismatch_count",
        "deficit_score_below", "repeated_deficit_count", "trend_window_attempts",
        "gate_failure_escalates_immediately"
      ],
      "properties": {
        "self_independent_delta_points": {"type": "number", "minimum": 0, "maximum": 100},
        "calibration_mismatch_count": {"type": "integer", "minimum": 1},
        "deficit_score_below": {"type": "number", "minimum": 0, "maximum": 100},
        "repeated_deficit_count": {"type": "integer", "minimum": 2},
        "trend_window_attempts": {"type": "integer", "minimum": 2},
        "gate_failure_escalates_immediately": {"type": "boolean"}
      }
    },
    "exception_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["not_an_exception", "eligible_signals", "event_type", "review_status"],
      "properties": {
        "not_an_exception": {"type": "string", "minLength": 1},
        "eligible_signals": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "event_type": {"const": "agent_behavior_exception"},
        "review_status": {"const": "candidate"}
      }
    },
    "instruction_change_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auto_apply", "human_gate_required", "minimum_change", "anti_bloat", "rollback_required"],
      "properties": {
        "auto_apply": {"const": false},
        "human_gate_required": {"const": true},
        "minimum_change": {"type": "string", "minLength": 1},
        "anti_bloat": {"type": "string", "minLength": 1},
        "rollback_required": {"const": true}
      }
    },
    "authority_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preferred_model_family", "reasoning_effort", "reason"],
      "properties": {
        "preferred_model_family": {"enum": ["luna", "terra", "sol"]},
        "reasoning_effort": {"enum": ["low", "medium", "high", "xhigh"]},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
