{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dad.local/schemas/agent-family-portfolio-registry-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "registry_version",
    "status",
    "candidate_only",
    "ai_agnostic",
    "authority_boundary",
    "shared_contract",
    "runtime_routing",
    "promotion_policy",
    "portfolio_wip_policy",
    "research_policy",
    "cockpit_policy",
    "graph_contract",
    "families",
    "pilots"
  ],
  "properties": {
    "schema_version": {
      "const": "dad.agent_family_portfolio_registry.v1"
    },
    "registry_id": {
      "const": "agent-family-portfolio-registry"
    },
    "registry_version": {
      "$ref": "#/$defs/version"
    },
    "status": {
      "const": "candidate"
    },
    "candidate_only": {
      "const": true
    },
    "ai_agnostic": {
      "const": true
    },
    "authority_boundary": {
      "type": "string",
      "minLength": 20
    },
    "shared_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roles",
        "interfaces",
        "lifecycle_states",
        "max_delegation_depth",
        "one_writer",
        "independent_checker_required",
        "sentinel_execution_authorized",
        "generated_relations_are_candidate"
      ],
      "properties": {
        "roles": {
          "type": "array",
          "prefixItems": [
            {
              "const": "router"
            },
            {
              "const": "boss"
            },
            {
              "const": "architect"
            },
            {
              "const": "foreman"
            },
            {
              "const": "worker"
            },
            {
              "const": "independent_checker"
            },
            {
              "const": "sentinel"
            }
          ],
          "items": false,
          "minItems": 7,
          "maxItems": 7
        },
        "interfaces": {
          "type": "array",
          "prefixItems": [
            {
              "const": "family_manifest"
            },
            {
              "const": "capability_contract"
            },
            {
              "const": "assignment"
            },
            {
              "const": "evidence"
            },
            {
              "const": "challenge"
            },
            {
              "const": "health_snapshot"
            },
            {
              "const": "candidate_change"
            },
            {
              "const": "human_decision"
            }
          ],
          "items": false,
          "minItems": 8,
          "maxItems": 8
        },
        "lifecycle_states": {
          "type": "array",
          "prefixItems": [
            {
              "const": "candidate"
            },
            {
              "const": "piloted"
            },
            {
              "const": "reviewed"
            },
            {
              "const": "active"
            },
            {
              "const": "watch"
            },
            {
              "const": "stale"
            },
            {
              "const": "superseded"
            },
            {
              "const": "retired"
            }
          ],
          "items": false,
          "minItems": 8,
          "maxItems": 8
        },
        "max_delegation_depth": {
          "const": 1
        },
        "one_writer": {
          "const": true
        },
        "independent_checker_required": {
          "const": true
        },
        "sentinel_execution_authorized": {
          "const": false
        },
        "generated_relations_are_candidate": {
          "const": true
        }
      }
    },
    "runtime_routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_aliases",
        "stable_identity_basis",
        "attempt_only_fields",
        "resolution_inputs",
        "fail_closed_rule"
      ],
      "properties": {
        "capability_aliases": {
          "type": "array",
          "prefixItems": [
            {
              "const": "luna"
            },
            {
              "const": "terra"
            },
            {
              "const": "sol"
            }
          ],
          "items": false
        },
        "stable_identity_basis": {
          "$ref": "#/$defs/strings"
        },
        "attempt_only_fields": {
          "$ref": "#/$defs/strings"
        },
        "resolution_inputs": {
          "$ref": "#/$defs/strings"
        },
        "fail_closed_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "promotion_policy": {
      "$ref": "#/$defs/openObject"
    },
    "portfolio_wip_policy": {
      "$ref": "#/$defs/openObject"
    },
    "research_policy": {
      "$ref": "#/$defs/openObject"
    },
    "cockpit_policy": {
      "$ref": "#/$defs/openObject"
    },
    "graph_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_types",
        "edge_types",
        "dependency_edges",
        "forbidden_claims"
      ],
      "properties": {
        "node_types": {
          "$ref": "#/$defs/strings"
        },
        "edge_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "depends_on",
              "implements",
              "member_of",
              "validated_by",
              "governed_by",
              "applies_to",
              "observed_by",
              "stale_due_to",
              "conflicts_with",
              "supersedes"
            ]
          }
        },
        "dependency_edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "forbidden_claims": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "families": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/family"
      }
    },
    "pilots": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/pilot"
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "strings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "openObject": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "edge_type",
        "target",
        "evidence_ref",
        "review_status"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "edge_type": {
          "enum": [
            "depends_on",
            "implements",
            "validated_by",
            "governed_by",
            "applies_to",
            "observed_by",
            "stale_due_to",
            "conflicts_with",
            "supersedes",
            "member_of"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "review_status": {
          "const": "candidate"
        }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "name",
        "kind",
        "build_order",
        "lifecycle_state",
        "status",
        "skill_ref",
        "pack_ref",
        "domains",
        "trigger_terms",
        "capabilities",
        "specialist_packs",
        "human_gates",
        "owner_authority",
        "requires_independent_assurance",
        "validation_ref",
        "freshness_sources",
        "review_cadence",
        "applies_when",
        "does_not_apply_when",
        "danger_if_misapplied"
      ],
      "properties": {
        "family_id": {
          "type": "string",
          "pattern": "^family:[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "core",
            "domain_overlay"
          ]
        },
        "build_order": {
          "type": "integer",
          "minimum": 1
        },
        "lifecycle_state": {
          "enum": [
            "candidate",
            "piloted",
            "reviewed",
            "active",
            "watch",
            "stale",
            "superseded",
            "retired"
          ]
        },
        "status": {
          "const": "implemented_candidate"
        },
        "skill_ref": {
          "type": "string",
          "pattern": "^skill:[a-z0-9][a-z0-9-]*$"
        },
        "pack_ref": {
          "type": "string",
          "pattern": "^assets/agent-skills/.+/subagents\\.yaml$"
        },
        "domains": {
          "$ref": "#/$defs/strings"
        },
        "trigger_terms": {
          "$ref": "#/$defs/strings"
        },
        "capabilities": {
          "$ref": "#/$defs/strings"
        },
        "specialist_packs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "human_gates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "owner_authority": {
          "type": "string",
          "minLength": 1
        },
        "requires_independent_assurance": {
          "type": "boolean"
        },
        "validation_ref": {
          "type": "string",
          "minLength": 1
        },
        "freshness_sources": {
          "$ref": "#/$defs/strings"
        },
        "review_cadence": {
          "type": "string",
          "minLength": 1
        },
        "applies_when": {
          "$ref": "#/$defs/strings"
        },
        "does_not_apply_when": {
          "$ref": "#/$defs/strings"
        },
        "danger_if_misapplied": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pilot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pilot_id",
        "repo_id",
        "status",
        "privacy_scope",
        "family_ids",
        "overlay_ids",
        "metadata_allowlist",
        "forbidden_data",
        "mutation_authorized",
        "human_gate"
      ],
      "properties": {
        "pilot_id": {
          "type": "string",
          "pattern": "^pilot:[a-z0-9][a-z0-9-]*$"
        },
        "repo_id": {
          "type": "string",
          "pattern": "^repo:[a-z0-9][a-z0-9-]*$"
        },
        "status": {
          "enum": [
            "active_candidate_pilot",
            "piloted_candidate",
            "incubating"
          ]
        },
        "privacy_scope": {
          "type": "string",
          "minLength": 1
        },
        "family_ids": {
          "$ref": "#/$defs/strings"
        },
        "overlay_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^family:"
          }
        },
        "metadata_allowlist": {
          "$ref": "#/$defs/strings"
        },
        "forbidden_data": {
          "$ref": "#/$defs/strings"
        },
        "mutation_authorized": {
          "const": false
        },
        "human_gate": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
