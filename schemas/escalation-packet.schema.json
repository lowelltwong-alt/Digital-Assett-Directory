{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.digital-asset-directory/schemas/escalation-packet.schema.json",
  "title": "Background Connection Escalation Packet Record",
  "type": "object",
  "required": [
    "schema_version",
    "packet_id",
    "connection_candidate_id",
    "scan_id_watermark",
    "attention_seed_ids",
    "cold_memory_cue",
    "source_asset_ids",
    "target_asset_ids",
    "deduped_member_candidate_ids",
    "minimal_context",
    "redacted_evidence_snippets",
    "cheap_signal_evidence",
    "component_scores",
    "connectivity_score",
    "proposed_connection_type",
    "reuse_first_edge_mapping",
    "why_might_matter_now",
    "why_might_be_false",
    "stop_conditions",
    "safety_cleared",
    "requested_verifier_tasks",
    "budget_priority",
    "evidence",
    "methodology_version",
    "generated_at",
    "scan_id",
    "review_status"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "packet_id": {"type": "string", "minLength": 1},
    "connection_candidate_id": {"type": "string", "minLength": 1},
    "scan_id_watermark": {"type": "string", "minLength": 1},
    "attention_seed_ids": {"type": "array", "items": {"type": "string"}},
    "cold_memory_cue": {"type": "string", "minLength": 1},
    "source_asset_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "target_asset_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "deduped_member_candidate_ids": {"type": "array", "items": {"type": "string"}},
    "minimal_context": {"type": "array", "items": {"type": "object"}, "minItems": 1},
    "redacted_evidence_snippets": {"type": "array", "items": {"type": "string"}},
    "cheap_signal_evidence": {"type": "object", "minProperties": 1},
    "component_scores": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "connectivity_score": {"type": "number", "minimum": 0, "maximum": 1},
    "proposed_connection_type": {"type": "string", "minLength": 1},
    "reuse_first_edge_mapping": {"type": "array", "items": {"type": "string"}},
    "why_might_matter_now": {"type": "string", "minLength": 1},
    "why_might_be_false": {"type": "string", "minLength": 1},
    "stop_conditions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "safety_cleared": {"const": true},
    "requested_verifier_tasks": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "budget_priority": {"type": "integer", "minimum": 1},
    "evidence": {"type": "object", "minProperties": 1},
    "methodology_version": {"const": "background-connection-connectivity-v1"},
    "generated_at": {"type": "string"},
    "scan_id": {"type": "string", "minLength": 1},
    "review_status": {"enum": ["generated_candidate", "reviewed", "rejected"]}
  },
  "additionalProperties": false
}
