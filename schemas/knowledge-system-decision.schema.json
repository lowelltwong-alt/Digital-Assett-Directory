{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.digital-asset-directory/schemas/knowledge-system-decision.schema.json",
  "title": "Knowledge System Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "created_at", "goal", "decision_owner", "source_authority", "authority_and_sensitivity", "query_shapes", "no_retrieval_baseline", "candidate_technique_ids", "recommendation", "ingestion_contract", "evaluation_contract", "human_gates", "rollback_and_kill_criteria", "unknowns", "evidence_refs", "review_status", "authority_boundary"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "decision_id": {"type": "string", "pattern": "^knowledge-system-decision:[a-z0-9][a-z0-9-]*$"},
    "created_at": {"type": "string", "format": "date-time"},
    "goal": {"type": "string", "minLength": 1},
    "decision_owner": {"type": "string", "minLength": 1},
    "source_authority": {"type": "string", "minLength": 1},
    "authority_and_sensitivity": {"type": "string", "minLength": 1},
    "query_shapes": {"$ref": "#/$defs/nonEmptyStrings"},
    "no_retrieval_baseline": {"type": "string", "minLength": 1},
    "candidate_technique_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^ke-technique:[a-z0-9][a-z0-9-]*$"}},
    "recommendation": {"enum": ["no_retrieval", "bounded_experiment", "investigate", "blocked", "human_decision_required"]},
    "ingestion_contract": {"type": "string", "minLength": 1},
    "evaluation_contract": {"type": "string", "minLength": 1},
    "human_gates": {"$ref": "#/$defs/nonEmptyStrings"},
    "rollback_and_kill_criteria": {"$ref": "#/$defs/nonEmptyStrings"},
    "unknowns": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence_refs": {"$ref": "#/$defs/nonEmptyStrings"},
    "review_status": {"enum": ["candidate", "reviewed", "rejected", "superseded"]},
    "authority_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {"nonEmptyStrings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
}
