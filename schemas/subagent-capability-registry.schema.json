{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.digital-asset-directory/schemas/subagent-capability-registry.schema.json",
  "title": "Subagent Capability Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "status", "capabilities", "rule"],
  "properties": {
    "registry_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["candidate", "reviewed", "deprecated"]},
    "capabilities": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "description"],
        "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "description": {"type": "string", "minLength": 1}}
      }
    },
    "rule": {"type": "string", "minLength": 1}
  }
}
