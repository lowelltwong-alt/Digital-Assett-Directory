{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.digital-asset-directory/schemas/asset-identity-layer.schema.json",
  "title": "Asset Identity Layer Registry",
  "type": "object",
  "required": ["registry_version", "status", "authority_doc", "layers"],
  "properties": {
    "registry_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["seed", "active", "deprecated"]
    },
    "authority_doc": {
      "type": "string",
      "minLength": 1
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "order",
          "status",
          "question",
          "outputs",
          "authority_posture",
          "required_controls"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "authority_posture": {
            "type": "string",
            "minLength": 1
          },
          "required_controls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
