{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.digital-asset-directory/schemas/learning-rule.schema.json",
  "title": "Deterministic Learning Rule Record",
  "type": "object",
  "required": [
    "schema_version",
    "rule_id",
    "title",
    "summary",
    "trigger_terms",
    "trigger_path_patterns",
    "context_tags",
    "applies_when",
    "does_not_apply_when",
    "required_actions",
    "danger_if_ignored",
    "evidence",
    "enforcement_level",
    "review_status"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "rule_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "trigger_terms": {"type": "array", "items": {"type": "string"}},
    "trigger_path_patterns": {"type": "array", "items": {"type": "string"}},
    "context_tags": {"type": "array", "items": {"type": "string"}},
    "applies_when": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "does_not_apply_when": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "required_actions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "danger_if_ignored": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "enforcement_level": {"enum": ["surface", "require_ack", "human_gate"]},
    "review_status": {"enum": ["generated_candidate", "reviewed", "rejected"]}
  },
  "additionalProperties": false
}
