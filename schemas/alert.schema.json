{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.digital-asset-directory/schemas/alert.schema.json",
  "title": "Discovery Alert",
  "type": "object",
  "required": [
    "schema_version",
    "alert_id",
    "created_at",
    "alert_type",
    "severity",
    "title",
    "description",
    "asset_ids",
    "evidence",
    "recommended_action",
    "status",
    "scan_id"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "alert_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string"
    },
    "alert_type": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "asset_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "object"
    },
    "recommended_action": {
      "type": "string"
    },
    "status": {
      "enum": [
        "open",
        "acknowledged",
        "resolved",
        "dismissed"
      ]
    },
    "scan_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
