{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.digital-asset-directory/schemas/edge.schema.json",
  "title": "Asset Graph Edge",
  "type": "object",
  "required": [
    "schema_version",
    "edge_id",
    "edge_type",
    "source_asset_id",
    "target_asset_id",
    "method",
    "confidence",
    "evidence",
    "created_at",
    "scan_id"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "edge_id": {
      "type": "string",
      "minLength": 1
    },
    "edge_type": {
      "type": "string",
      "minLength": 1
    },
    "source_asset_id": {
      "type": "string",
      "minLength": 1
    },
    "target_asset_id": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "type": "object"
    },
    "created_at": {
      "type": "string"
    },
    "scan_id": {
      "type": "string",
      "minLength": 1
    },
    "review_status": {
      "enum": [
        "generated_candidate",
        "reviewed",
        "rejected"
      ]
    }
  },
  "additionalProperties": false
}
