{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.digital-asset-directory/schemas/synthetic-silver-release-manifest.schema.json",
  "title": "Synthetic Silver Release Manifest",
  "description": "One manifest per versioned silver release, owned by the domain repo. Measured performance numbers belong here; policy thresholds do not belong in the program registry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "release_id", "program_id", "task", "tier",
    "source_snapshots", "generation", "sampling_strategy", "counts",
    "audit", "performance", "known_limitations", "confidentiality_tier",
    "supersedes", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "release_id": {"type": "string", "minLength": 1},
    "program_id": {"const": "synthetic-silver"},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "task_version", "spec_version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "task_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "spec_version": {"type": "string", "minLength": 1}
      }
    },
    "tier": {"enum": ["S0", "S1", "S2", "S3"]},
    "source_snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["snapshot_id", "sha256"],
        "properties": {
          "snapshot_id": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code_commit", "prompt_hashes", "producers"],
      "properties": {
        "code_commit": {"type": "string", "minLength": 1},
        "prompt_hashes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "producers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["producer", "producer_family", "producer_version"],
            "properties": {
              "producer": {"type": "string", "minLength": 1},
              "producer_family": {"type": "string", "minLength": 1},
              "producer_version": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "sampling_strategy": {"type": "string", "minLength": 1},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items_total", "accepted", "needs_review", "rejected",
        "hard_validator_failures", "by_stratum"
      ],
      "properties": {
        "items_total": {"type": "integer", "minimum": 0},
        "accepted": {"type": "integer", "minimum": 0},
        "needs_review": {"type": "integer", "minimum": 0},
        "rejected": {"type": "integer", "minimum": 0},
        "hard_validator_failures": {"type": "integer", "minimum": 0},
        "by_stratum": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stratum", "items"],
            "properties": {
              "stratum": {"type": "string", "minLength": 1},
              "items": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_size", "findings"],
      "properties": {
        "sample_size": {"type": "integer", "minimum": 0},
        "findings": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gold_anchor", "gold_holdout"],
      "properties": {
        "gold_anchor": {"$ref": "#/$defs/metricMap"},
        "gold_holdout": {"$ref": "#/$defs/metricMap"}
      }
    },
    "known_limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "confidentiality_tier": {"enum": ["public", "internal", "restricted", "unknown"]},
    "supersedes": {"type": ["string", "null"]},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "metricMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": ["number", "integer", "string"]}
    }
  }
}
