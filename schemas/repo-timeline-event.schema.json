{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.digital-asset-directory/schemas/repo-timeline-event.schema.json",
  "title": "Repository Timeline Event Record",
  "type": "object",
  "required": [
    "schema_version",
    "timeline_event_id",
    "repository_path",
    "event_type",
    "occurred_at",
    "asset_ids",
    "changed_paths",
    "summary",
    "evidence",
    "context_tags",
    "generated_at",
    "scan_id",
    "review_status"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "timeline_event_id": {"type": "string", "minLength": 1},
    "repository_path": {"type": "string", "minLength": 1},
    "event_type": {"enum": ["commit", "merge", "revert", "file_change", "changelog", "ci_artifact", "learning_event"]},
    "occurred_at": {"type": "string"},
    "asset_ids": {"type": "array", "items": {"type": "string"}},
    "changed_paths": {"type": "array", "items": {"type": "string"}},
    "summary": {"type": "string", "minLength": 1},
    "evidence": {"type": "object", "minProperties": 1},
    "context_tags": {"type": "array", "items": {"type": "string"}},
    "generated_at": {"type": "string"},
    "scan_id": {"type": "string", "minLength": 1},
    "review_status": {"enum": ["generated_candidate", "reviewed", "rejected"]}
  },
  "additionalProperties": false
}
