{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.digital-asset-directory/schemas/repo-asset-usage.schema.json",
  "title": "Repo Asset Usage Record",
  "type": "object",
  "required": [
    "schema_version",
    "usage_id",
    "repo",
    "asset_id",
    "status",
    "recorded_at",
    "recorded_by",
    "upgrade_channel",
    "local_write",
    "authority_boundary"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "usage_id": {"type": "string", "minLength": 1},
    "repo": {"type": "string", "minLength": 1},
    "repo_id": {"type": "string"},
    "asset_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["using", "watching", "depends_on", "dependency_candidate", "rejected", "retired"]},
    "dependency_basis": {
      "enum": ["explicit_repo_record", "human_reviewed", "imported_candidate"]
    },
    "recorded_at": {"type": "string", "minLength": 1},
    "recorded_by": {"type": "string", "minLength": 1},
    "source_ref": {"type": "string"},
    "reason": {"type": "string"},
    "mail_id": {"type": "string"},
    "adoption_id": {"type": "string"},
    "upgrade_channel": {"enum": ["dad_mail", "manual_review", "none"]},
    "local_write": {"type": "boolean"},
    "central_only_reason": {"type": "string"},
    "authority_boundary": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "depends_on"}}, "required": ["status"]},
      "then": {
        "required": ["dependency_basis"],
        "properties": {"dependency_basis": {"enum": ["explicit_repo_record", "human_reviewed"]}}
      }
    },
    {
      "if": {"properties": {"status": {"const": "dependency_candidate"}}, "required": ["status"]},
      "then": {
        "required": ["dependency_basis"],
        "properties": {"dependency_basis": {"const": "imported_candidate"}}
      }
    }
  ],
  "additionalProperties": false
}
