{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.digital-asset-directory/schemas/graph-surface-registry.schema.json",
  "title": "DAD Graph Surface Registry",
  "description": "Neutral registry for named generated graph projections. Registries remain authority; graph surfaces are rebuildable candidate evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "status", "authority_boundary", "surfaces"],
  "properties": {
    "registry_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["seed", "candidate", "reviewed", "deprecated"]},
    "authority_boundary": {"type": "string", "minLength": 1},
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "surface_id",
          "surface_kind",
          "ontology_id",
          "status",
          "purpose",
          "builder",
          "source_inputs",
          "outputs",
          "schema_refs",
          "freshness_policy",
          "consumers",
          "review_status",
          "authority_boundary"
        ],
        "properties": {
          "surface_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "surface_kind": {"const": "generated_graph_surface"},
          "ontology_id": {
            "enum": ["knowledge", "research-intake", "exceptions", "operations"]
          },
          "status": {"enum": ["active", "partial", "planned", "deprecated"]},
          "purpose": {"type": "string", "minLength": 1},
          "builder": {
            "type": "object",
            "additionalProperties": false,
            "required": ["availability", "command", "module"],
            "properties": {
              "availability": {"enum": ["wired", "partial", "planned", "deferred"]},
              "command": {"type": "string", "minLength": 1},
              "module": {"type": "string", "minLength": 1}
            }
          },
          "source_inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "ref", "required"],
              "properties": {
                "kind": {
                  "enum": ["data_surface", "registry_path", "schema_path", "source_path"]
                },
                "ref": {"type": "string", "minLength": 1},
                "required": {"type": "boolean"}
              }
            }
          },
          "outputs": {
            "type": "object",
            "additionalProperties": false,
            "required": ["manifest_logical_path", "body_logical_path"],
            "properties": {
              "manifest_logical_path": {"type": "string", "minLength": 1},
              "body_logical_path": {"type": "string", "minLength": 1}
            }
          },
          "schema_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "freshness_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fresh", "stale", "inconsistent"],
            "properties": {
              "fresh": {"const": "hashes_match"},
              "stale": {"const": "warn"},
              "inconsistent": {"const": "block"}
            }
          },
          "consumers": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "review_status": {"enum": ["candidate", "reviewed", "deprecated"]},
          "authority_boundary": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
