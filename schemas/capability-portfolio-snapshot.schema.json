{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dad.local/schemas/capability-portfolio-snapshot-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "status", "candidate_only", "execution_authorized", "catalog_fingerprint", "source_fingerprints", "summary", "capabilities", "workflows", "workflow_candidates", "gap_candidates", "routines", "efficiency", "operator", "authority_boundary"],
  "properties": {
    "schema_version": {"const": "dad.capability_portfolio_snapshot.v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["generated_candidate", "partial_candidate"]},
    "candidate_only": {"const": true},
    "execution_authorized": {"const": false},
    "catalog_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_fingerprints": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "summary": {"type": "object", "required": ["capability_count", "workflow_count", "operational_route_count", "operational_run_count", "gap_candidate_count", "unobserved_capability_count"], "properties": {"capability_count": {"type": "integer", "minimum": 0}, "workflow_count": {"type": "integer", "minimum": 0}, "operational_route_count": {"type": "integer", "minimum": 0}, "operational_run_count": {"type": "integer", "minimum": 0}, "gap_candidate_count": {"type": "integer", "minimum": 0}, "unobserved_capability_count": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "capabilities": {"type": "array", "items": {"$ref": "#/$defs/usage"}},
    "workflows": {"type": "array", "items": {"$ref": "#/$defs/usage"}},
    "workflow_candidates": {"type": "array", "items": {"$ref": "#/$defs/workflowCandidate"}},
    "gap_candidates": {"type": "array", "items": {"$ref": "#/$defs/gap"}},
    "routines": {"type": "array", "items": {"$ref": "#/$defs/routine"}},
    "efficiency": {"type": "object", "additionalProperties": false, "required": ["model_call_count", "known_input_tokens", "known_output_tokens", "known_cache_read_tokens", "unknown_token_event_count", "known_cost_total", "unknown_cost_event_count", "deterministic_run_count", "agent_run_count", "external_adapter_run_count", "context_cache_hit_count"], "properties": {"model_call_count": {"type": "integer", "minimum": 0}, "known_input_tokens": {"type": "integer", "minimum": 0}, "known_output_tokens": {"type": "integer", "minimum": 0}, "known_cache_read_tokens": {"type": "integer", "minimum": 0}, "unknown_token_event_count": {"type": "integer", "minimum": 0}, "known_cost_total": {"type": "number", "minimum": 0}, "unknown_cost_event_count": {"type": "integer", "minimum": 0}, "deterministic_run_count": {"type": "integer", "minimum": 0}, "agent_run_count": {"type": "integer", "minimum": 0}, "external_adapter_run_count": {"type": "integer", "minimum": 0}, "context_cache_hit_count": {"type": "integer", "minimum": 0}}},
    "operator": {"type": "object", "required": ["now", "digest", "overflow_count", "quiet_mode", "immediate_decision_count", "review_minutes_estimate"], "properties": {"now": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/decision"}}, "digest": {"type": "array", "items": {"$ref": "#/$defs/decision"}}, "overflow_count": {"type": "integer", "minimum": 0}, "quiet_mode": {"type": "boolean"}, "immediate_decision_count": {"type": "integer", "maximum": 3}, "review_minutes_estimate": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "authority_boundary": {"type": "string", "minLength": 20}
  },
  "$defs": {
    "usage": {"type": "object", "additionalProperties": false, "required": ["entity_id", "observation_status", "eligible_considered_count", "selected_count", "executed_count", "completed_count", "independently_validated_count", "supported_success_count", "supported_partial_count", "supported_failure_count", "supported_unknown_count", "last_considered_at", "last_selected_at", "last_executed_at", "last_used_at", "last_independently_validated_at"], "properties": {"entity_id": {"type": "string"}, "observation_status": {"enum": ["unobserved", "observed", "watch", "stale", "superseded", "unknown"]}, "eligible_considered_count": {"type": "integer", "minimum": 0}, "selected_count": {"type": "integer", "minimum": 0}, "executed_count": {"type": "integer", "minimum": 0}, "completed_count": {"type": "integer", "minimum": 0}, "independently_validated_count": {"type": "integer", "minimum": 0}, "supported_success_count": {"type": "integer", "minimum": 0}, "supported_partial_count": {"type": "integer", "minimum": 0}, "supported_failure_count": {"type": "integer", "minimum": 0}, "supported_unknown_count": {"type": "integer", "minimum": 0}, "last_considered_at": {"type": ["string", "null"]}, "last_selected_at": {"type": ["string", "null"]}, "last_executed_at": {"type": ["string", "null"]}, "last_used_at": {"type": ["string", "null"]}, "last_independently_validated_at": {"type": ["string", "null"]}}},
    "workflowCandidate": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "fingerprint", "capability_sequence", "validated_run_count", "status", "human_decision_required", "evidence_refs"], "properties": {"candidate_id": {"type": "string"}, "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "capability_sequence": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^capability:"}}, "validated_run_count": {"type": "integer", "minimum": 3}, "status": {"const": "candidate"}, "human_decision_required": {"const": true}, "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}},
    "gap": {"type": "object", "additionalProperties": false, "required": ["gap_id", "fingerprint", "gap_type", "disposition", "affected_ids", "evidence_refs", "counterevidence_refs", "next_review", "human_decision_required"], "properties": {"gap_id": {"type": "string"}, "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "gap_type": {"type": "string"}, "disposition": {"enum": ["no_change", "observe_more", "route_existing", "improve_candidate", "new_candidate"]}, "affected_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "counterevidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "next_review": {"type": "string"}, "human_decision_required": {"type": "boolean"}}},
    "decision": {"type": "object", "additionalProperties": false, "required": ["decision_id", "decision_key", "kind", "label", "recommended_action", "alternatives", "covered_item_count", "evidence_refs", "human_only", "fingerprint"], "properties": {"decision_id": {"type": "string"}, "decision_key": {"type": "string"}, "kind": {"enum": ["coverage_gap", "workflow_candidate", "health_risk", "budget_pause", "authority_gate"]}, "label": {"type": "string"}, "recommended_action": {"type": "string"}, "alternatives": {"type": "array", "items": {"type": "string"}}, "covered_item_count": {"type": "integer", "minimum": 1}, "evidence_refs": {"type": "array", "items": {"type": "string"}}, "human_only": {"const": true}, "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "routine": {"type": "object", "additionalProperties": false, "required": ["routine_id", "revision", "activation_status", "evaluation_status", "input_fingerprint", "previous_fingerprint", "idempotency_key", "reason_codes", "model_call_count", "model_tokens", "notification_authorized", "external_mutation_authorized", "human_decision_required"], "properties": {"routine_id": {"type": "string"}, "revision": {"type": "string"}, "activation_status": {"enum": ["dormant", "activated_by_explicit_input"]}, "evaluation_status": {"enum": ["dormant", "suppressed", "baseline_required", "unchanged_heartbeat", "candidate_due"]}, "input_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "previous_fingerprint": {"type": ["string", "null"]}, "idempotency_key": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "model_call_count": {"const": 0}, "model_tokens": {"const": 0}, "notification_authorized": {"const": false}, "external_mutation_authorized": {"const": false}, "human_decision_required": {"type": "boolean"}}}
  }
}
