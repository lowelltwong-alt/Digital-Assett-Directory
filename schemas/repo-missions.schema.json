{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.digital-asset-directory/schemas/repo-missions.schema.json",
  "title": "Repository-Owned Mission Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repo_ref",
    "status",
    "data_classification",
    "c3_payload_included",
    "human_review_required",
    "authority_boundary",
    "mission",
    "source_evidence",
    "tracks"
  ],
  "properties": {
    "schema_version": {"const": "dad.repo-missions.v1"},
    "repo_ref": {"type": "string", "pattern": "^dad://repo/[a-z0-9][a-z0-9-]*$"},
    "status": {"enum": ["candidate", "reviewed", "superseded", "retired"]},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "data_classification": {"enum": ["C0_public", "C1_internal_metadata", "C2_private_metadata"]},
    "c3_payload_included": {"const": false},
    "human_review_required": {"const": true},
    "authority_boundary": {"type": "string", "minLength": 1},
    "mission": {"type": "string", "minLength": 1},
    "source_evidence": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?![A-Za-z]:)(?!/)(?!~)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/track"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "reviewed"}},
        "required": ["status"]
      },
      "then": {"required": ["reviewed_at"]}
    }
  ],
  "$defs": {
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["track_id", "goal", "review_status", "map_rules"],
      "properties": {
        "track_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "goal": {"type": "string", "minLength": 1},
        "review_status": {"enum": ["candidate", "reviewed", "superseded", "retired"]},
        "milestones": {
          "type": "array",
          "items": {"$ref": "#/$defs/milestone"}
        },
        "experiments": {
          "type": "array",
          "items": {"$ref": "#/$defs/experiment"}
        },
        "shared_with": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^dad://repo/[a-z0-9][a-z0-9-]*$"}
        },
        "map_rules": {"$ref": "#/$defs/mapRules"}
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["planned", "in_progress", "blocked", "validated", "complete", "superseded"]}
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "metric", "baseline"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "metric": {"type": "string", "minLength": 1},
        "baseline": {"type": "string", "minLength": 1},
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit", "limit", "period"],
          "properties": {
            "unit": {"type": "string", "minLength": 1},
            "limit": {"type": "number", "exclusiveMinimum": 0},
            "period": {"enum": ["run", "daily", "weekly", "monthly", "quarterly", "annual"]}
          }
        }
      }
    },
    "mapRules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch_patterns", "path_globs"],
      "properties": {
        "branch_patterns": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![A-Za-z]:)(?!/)(?!~)(?!.*\\.\\.)[^\\\\\\r\\n]+$"
          }
        },
        "path_globs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![A-Za-z]:)(?!/)(?!~)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\r\\n]+$"
          }
        }
      }
    }
  }
}
