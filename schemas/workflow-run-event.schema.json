{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dad.local/schemas/workflow-run-event-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["specversion", "id", "source", "type", "subject", "time", "dataschema", "workflow_id", "workflow_revision_id", "run_id", "route_event_id", "event_state", "capability_ids", "input_fingerprint", "execution_mode", "producer_ref", "material_execution", "retry_count", "evidence_refs", "validation_refs", "dependency_refs", "synthetic_or_fixture", "privacy_class", "token_usage", "cost_usage", "authority_boundary"],
  "properties": {
    "specversion": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^run-event:[a-z0-9-]+$"},
    "source": {"const": "dad://capability-os/workflow-runner"},
    "type": {"enum": ["dad.workflow.run.started.v1", "dad.workflow.run.running.v1", "dad.workflow.run.completed.v1", "dad.workflow.run.failed.v1", "dad.workflow.run.aborted.v1", "dad.workflow.run.validated.v1", "dad.workflow.run.corrected.v1"]},
    "subject": {"type": "string", "pattern": "^workflow-run:[a-z0-9-]+$"},
    "time": {"type": "string", "format": "date-time"},
    "dataschema": {"const": "schemas/workflow-run-event.schema.json"},
    "workflow_id": {"type": "string", "pattern": "^workflow:"},
    "workflow_revision_id": {"type": "string", "pattern": "^workflow-revision:.*:v[1-9][0-9]*$"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "route_event_id": {"type": "string", "pattern": "^route-event:"},
    "event_state": {"enum": ["started", "running", "completed", "failed", "aborted", "independently_validated", "corrected"]},
    "capability_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^capability:"}},
    "input_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "output_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "execution_mode": {"enum": ["deterministic", "agent", "external_adapter"]},
    "producer_ref": {"type": "string", "minLength": 3},
    "adapter_id": {"type": "string", "pattern": "^adapter:"},
    "context_cache_hit": {"type": "boolean"},
    "context_capsule_ref": {"type": "string"},
    "independent_checker_ref": {"type": "string"},
    "independent_evaluation_ref": {"type": "string"},
    "validation_outcome": {"enum": ["supported_success", "supported_partial", "supported_failure", "unknown", "not_applicable"]},
    "result_reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
    "material_execution": {"type": "boolean"},
    "plan_id": {"type": "string"}, "plan_revision_id": {"type": "string"},
    "entity_id": {"type": "string"}, "entity_revision_id": {"type": "string"},
    "workstream_id": {"type": "string"}, "family_id": {"type": "string"}, "role_id": {"type": "string"}, "attempt_id": {"type": "string"},
    "runtime_route_decision_id": {"type": "string"}, "harness_revision_id": {"type": "string"}, "lease_id": {"type": "string"}, "effect_class": {"type": "string"},
    "tool_time_ms": {"type": "integer", "minimum": 0}, "retry_count": {"type": "integer", "minimum": 0},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "validation_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "dependency_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "synthetic_or_fixture": {"type": "boolean"},
    "privacy_class": {"enum": ["public", "internal_metadata", "private_metadata", "restricted"]},
    "token_usage": {"$ref": "#/$defs/tokenUsage"},
    "cost_usage": {"$ref": "#/$defs/costUsage"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "model_call_count": {"type": "integer", "minimum": 0},
    "corrects_event_id": {"type": "string", "pattern": "^run-event:"},
    "authority_boundary": {"type": "string", "minLength": 20}
  },
  "allOf": [
    {
      "if": {"properties": {"material_execution": {"const": true}}, "required": ["material_execution"]},
      "then": {"required": ["plan_revision_id", "entity_revision_id", "family_id", "role_id", "attempt_id", "runtime_route_decision_id", "harness_revision_id", "lease_id", "effect_class"]}
    }
  ],
  "$defs": {
    "tokenUsage": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "input_tokens", "output_tokens", "cache_read_tokens"],
      "properties": {"status": {"enum": ["known", "estimated", "unknown"]}, "input_tokens": {"type": ["integer", "null"], "minimum": 0}, "output_tokens": {"type": ["integer", "null"], "minimum": 0}, "cache_read_tokens": {"type": ["integer", "null"], "minimum": 0}}
    },
    "costUsage": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "amount", "currency"],
      "properties": {"status": {"enum": ["known", "estimated", "unknown"]}, "amount": {"type": ["number", "null"], "minimum": 0}, "currency": {"type": ["string", "null"]}}
    }
  }
}
