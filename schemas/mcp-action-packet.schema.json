{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dad.local/schemas/mcp-action-packet-v1.json",
  "title": "DAD MCP supervised action packet",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "packet_id", "request_id", "action_kind", "repository_id", "source_snapshot_digest", "expected_preconditions_digest", "issued_at", "expires_at", "human_gate_required", "approval_ref", "independent_checker_required", "execution_authorized", "mutations_performed"],
  "properties": {
    "schema_version": {"const": "dad.mcp.action_packet.v1"},
    "packet_id": {"type": "string", "pattern": "^dad:mcp-action-packet:[0-9a-f-]{36}$"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "action_kind": {"enum": ["preflight", "midflight", "postflight", "recovery", "dependency_refresh"]},
    "repository_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"},
    "case_id": {"type": "string", "maxLength": 160},
    "source_snapshot_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "expected_preconditions_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "issued_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"},
    "human_gate_required": {"const": true}, "approval_ref": {"type": "string", "minLength": 1, "maxLength": 160},
    "independent_checker_required": {"const": true}, "execution_authorized": {"const": false}, "mutations_performed": {"const": false},
    "rollback_ref": {"type": "string", "maxLength": 160}
  }
}
