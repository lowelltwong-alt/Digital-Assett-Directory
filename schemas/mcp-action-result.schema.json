{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dad.local/schemas/mcp-action-result-v1.json",
  "title": "DAD MCP supervised action result",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "result_id", "packet_id", "result_status", "before_snapshot_digest", "after_snapshot_digest", "worker_id", "checker_id", "evidence_refs", "execution_authorized"],
  "properties": {
    "schema_version": {"const": "dad.mcp.action_result.v1"},
    "result_id": {"type": "string", "pattern": "^dad:mcp-action-result:[0-9a-f-]{36}$"},
    "packet_id": {"type": "string", "pattern": "^dad:mcp-action-packet:[0-9a-f-]{36}$"},
    "result_status": {"enum": ["verified", "failed", "aborted"]},
    "before_snapshot_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "after_snapshot_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "worker_id": {"type": "string", "minLength": 1, "maxLength": 160}, "checker_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "maxLength": 240}},
    "execution_authorized": {"const": false}
  }
}
