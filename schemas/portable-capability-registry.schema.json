{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dad.local/schemas/portable-capability-registry-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "registry_version", "status", "active_policy_revision_id", "baseline", "cards", "candidate_only", "execution_authorized", "authority_boundary"],
  "properties": {
    "schema_version": {"const": "dad.portable_capability_registry.v1"},
    "registry_id": {"const": "portable-capability-registry"},
    "registry_version": {"type": "string"},
    "status": {"enum": ["shadow", "warn", "enforce_new_or_worsened", "reviewed_active"]},
    "active_policy_revision_id": {"type": "string", "pattern": "^portability-policy-revision:"},
    "baseline": {"type": "object", "additionalProperties": false, "required": ["baseline_id", "git_commit", "created_at", "source_surfaces", "content_digest"], "properties": {"baseline_id": {"type": "string", "pattern": "^portability-baseline:"}, "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "created_at": {"type": "string", "format": "date-time"}, "source_surfaces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "cards": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "candidate_only": {"const": true},
    "execution_authorized": {"const": false},
    "authority_boundary": {"type": "string", "minLength": 20}
  }
}
