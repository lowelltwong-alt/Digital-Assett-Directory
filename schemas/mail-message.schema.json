{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.digital-asset-directory/schemas/mail-message.schema.json",
  "title": "Mail Message Record",
  "type": "object",
  "required": [
    "schema_version",
    "mail_id",
    "thread_id",
    "message_type",
    "source_repo",
    "target_repo",
    "created_at",
    "dedupe_key",
    "sensitivity",
    "review_status",
    "payload",
    "evidence",
    "suggested_actions",
    "source_provenance",
    "public_release"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "mail_id": {"type": "string", "minLength": 1},
    "thread_id": {"type": "string", "minLength": 1},
    "message_type": {
      "enum": [
        "lesson_suggestion",
        "asset_suggestion",
        "workflow_suggestion",
        "taxonomy_suggestion",
        "capability_suggestion",
        "governance_notice",
        "inbox_ack",
        "review_decision"
      ]
    },
    "source_repo": {"type": "string", "minLength": 1},
    "target_repo": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "dedupe_key": {"type": "string", "minLength": 1},
    "sensitivity": {"enum": ["public", "internal", "confidential", "restricted", "unknown"]},
    "review_status": {
      "enum": [
        "generated_candidate",
        "collected_candidate",
        "routed_candidate",
        "delivered_candidate",
        "reviewed",
        "rejected",
        "archived"
      ]
    },
    "payload": {"type": "object"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "suggested_actions": {"type": "array", "items": {"type": "string"}},
    "source_provenance": {
      "type": "object",
      "required": [
        "canonical_source_repo",
        "source_repo_id",
        "source_repo_alias",
        "source_visibility",
        "original_source_chain",
        "return_address"
      ],
      "properties": {
        "canonical_source_repo": {"type": "string"},
        "source_repo_id": {"type": "string"},
        "source_repo_alias": {"type": "string"},
        "source_visibility": {"enum": ["public", "internal", "private", "restricted", "unknown"]},
        "original_source_chain": {"type": "array", "items": {"type": "string"}},
        "return_address": {"type": "string"},
        "original_mail_id": {"type": "string"},
        "composed_by": {"type": "string"},
        "collected_by": {"type": "string"},
        "collected_at": {"type": "string"},
        "received_at": {"type": "string"}
      },
      "additionalProperties": true
    },
    "public_release": {
      "type": "object",
      "required": [
        "target_visibility",
        "target_public_facing",
        "public_release_required",
        "public_release_status",
        "human_release_id",
        "release_reason"
      ],
      "properties": {
        "target_visibility": {"enum": ["public", "internal", "private", "restricted", "unknown"]},
        "target_public_facing": {"type": "boolean"},
        "public_release_required": {"type": "boolean"},
        "public_release_status": {"enum": ["not_required", "pending_human", "approved", "rejected"]},
        "human_release_id": {"type": "string"},
        "release_reason": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
