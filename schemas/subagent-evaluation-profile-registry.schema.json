{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.digital-asset-directory/schemas/subagent-evaluation-profile-registry.schema.json",
  "title": "Subagent Evaluation Profile Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "status", "universal_loop", "improvement_target_layers", "dispositions", "profiles", "authority_boundary"],
  "properties": {
    "registry_version": {"const": "0.1.0"},
    "status": {"const": "candidate"},
    "universal_loop": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "improvement_target_layers": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {"enum": ["agent_instruction", "model_route", "tool", "input_contract", "context_or_data", "workflow", "handoff", "evaluation_harness", "reviewer", "domain_overlay", "downstream_specialist", "preserve_simple", "observe_more"]}
    },
    "dispositions": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {"enum": ["no_change_freeze_candidate", "collect_more_evidence", "repair_task_or_rubric", "repair_evaluator", "revise_agent_instruction", "change_model_or_effort_route", "change_context_or_data", "change_tool_or_environment", "redesign_workflow_or_handoff", "compose_downstream_specialist", "require_domain_expert", "retire_or_supersede", "human_attribution_required"]}
    },
    "profiles": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/profile"}
    },
    "authority_boundary": {"type": "string", "minLength": 40}
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_version", "status", "applies_when", "does_not_apply_when", "danger_if_misapplied", "required_criteria", "domain_expert_required", "minimum_comparable_attempts_for_no_change", "cross_domain_comparison_forbidden", "authority_boundary"],
      "properties": {
        "profile_id": {"type": "string", "pattern": "^dad:evaluation-profile:[a-z0-9-]+$"},
        "profile_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "status": {"const": "candidate"},
        "applies_when": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}},
        "does_not_apply_when": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}},
        "danger_if_misapplied": {"type": "string", "minLength": 20},
        "required_criteria": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["criterion_id", "validator_kind", "description"],
            "properties": {
              "criterion_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "validator_kind": {"enum": ["deterministic", "independent_review", "domain_expert", "mixed"]},
              "description": {"type": "string", "minLength": 10}
            }
          }
        },
        "domain_expert_required": {"type": "boolean"},
        "minimum_comparable_attempts_for_no_change": {"type": "integer", "minimum": 3},
        "cross_domain_comparison_forbidden": {"const": true},
        "authority_boundary": {"type": "string", "minLength": 40}
      }
    }
  }
}
