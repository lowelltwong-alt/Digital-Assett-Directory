{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dad.local/schemas/portfolio-continuity-trial-operator-packet.schema.json",
  "title": "DAD supervised continuity trial operator packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "trial_id", "review_set_digest", "generated_at", "phase", "next_action",
    "host_readiness_status", "host_binding_current", "observed_review_count",
    "distinct_review_count", "minimum_review_count", "reviews_remaining",
    "trial_span_days", "minimum_span_days", "span_days_remaining", "first_review_at",
    "earliest_eligibility_at", "restart_required", "restart_reasons", "gate_failures",
    "review_contract", "human_actions_required", "delivery_authorized",
    "activation_authorized", "cleanup_authorized", "candidate_only",
    "execution_authorized", "authority_boundary", "packet_digest"
  ],
  "properties": {
    "schema_version": {"const": "dad.portfolio_continuity_trial_operator_packet.v1"},
    "trial_id": {"type": "string", "pattern": "^trial:[a-z0-9][a-z0-9._:-]{0,127}$"},
    "review_set_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "phase": {"enum": [
      "awaiting_host_readiness", "restart_required_after_correction",
      "collecting_supervised_reviews", "waiting_for_real_clock_span",
      "resolving_remaining_gates", "eligible_for_separate_human_approval"
    ]},
    "next_action": {"enum": [
      "complete_host_readiness", "correct_and_start_new_trial_revision",
      "record_next_supervised_review", "wait_then_record_span_extending_supervised_review",
      "record_span_extending_supervised_review",
      "resolve_remaining_gate_failures", "request_separate_activation_approval"
    ]},
    "host_readiness_status": {"enum": ["missing", "not_ready", "ready_for_supervised_trial"]},
    "host_binding_current": {"type": "boolean"},
    "observed_review_count": {"type": "integer", "minimum": 0},
    "distinct_review_count": {"type": "integer", "minimum": 0},
    "minimum_review_count": {"const": 5},
    "reviews_remaining": {"type": "integer", "minimum": 0, "maximum": 5},
    "trial_span_days": {"type": "number", "minimum": 0},
    "minimum_span_days": {"const": 7},
    "span_days_remaining": {"type": "number", "minimum": 0, "maximum": 7},
    "first_review_at": {"type": "string"},
    "earliest_eligibility_at": {"type": "string"},
    "restart_required": {"type": "boolean"},
    "restart_reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_.:-]+$"}},
    "gate_failures": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_.:-]+$"}},
    "review_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failure_metric_keys", "minimum_hook_sample_count", "maximum_asks_per_digest",
        "performance_measurement_origin", "hook_latency_within_budget_required",
        "latency_budget_source", "performance_evidence_digest_required",
        "adapter_interface_digest_match_required", "supervisor_attestation_required",
        "notification_content_safe_required",
        "production_clock_required", "zero_failure_metrics_required_for_activation"
      ],
      "properties": {
        "failure_metric_keys": {"const": [
          "missed_captures", "missed_recoveries", "unnecessary_captures",
          "harmful_captures", "false_duplicate_suggestions", "false_merges",
          "accidental_mutations", "unauthorized_mutations", "repeated_unchanged_asks",
          "privacy_escapes", "blind_delivery_retries", "model_calls_on_unchanged_cycles"
        ]},
        "minimum_hook_sample_count": {"const": 5},
        "maximum_asks_per_digest": {"const": 3},
        "performance_measurement_origin": {"const": "instrumented_harness"},
        "hook_latency_within_budget_required": {"const": true},
        "latency_budget_source": {"const": "validated_performance_evidence"},
        "performance_evidence_digest_required": {"const": true},
        "adapter_interface_digest_match_required": {"const": true},
        "supervisor_attestation_required": {"const": true},
        "notification_content_safe_required": {"const": true},
        "production_clock_required": {"const": true},
        "zero_failure_metrics_required_for_activation": {"const": true}
      }
    },
    "human_actions_required": {"type": "array", "maxItems": 5, "items": {"type": "string", "minLength": 20}},
    "delivery_authorized": {"const": false},
    "activation_authorized": {"const": false},
    "cleanup_authorized": {"const": false},
    "candidate_only": {"const": true},
    "execution_authorized": {"const": false},
    "authority_boundary": {"type": "string", "minLength": 80},
    "packet_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
