{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.digital-asset-directory/schemas/trusted-source-registry.schema.json",
  "title": "DAD Trusted Source Registry",
  "type": "object",
  "required": ["schema_version", "registry_id", "authority_boundary", "trust_tiers", "sources"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "registry_id": {"const": "trusted-source-registry"},
    "authority_boundary": {"type": "string", "minLength": 1},
    "trust_tiers": {
      "type": "object",
      "required": ["high_signal", "known", "unknown"],
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "label", "url_patterns", "trust_tier", "asset_kinds", "review_status"],
        "allOf": [
          {
            "if": {"required": ["language_focus"]},
            "then": {"required": ["check_cadence", "frontier_watch", "intake_actions"]}
          }
        ],
        "additionalProperties": false,
        "properties": {
          "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "label": {"type": "string", "minLength": 1},
          "url_patterns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
          "trust_tier": {"enum": ["high_signal", "known"]},
          "language_focus": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "check_cadence": {"enum": ["weekly", "monthly", "quarterly", "manual"]},
          "frontier_watch": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "intake_actions": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "asset_kinds": {
            "type": "array",
            "minItems": 1,
            "items": {"enum": ["skill", "harness", "asset", "lesson", "doc"]}
          },
          "notes": {"type": "string"},
          "review_status": {"enum": ["candidate", "reviewed"]}
        }
      }
    }
  }
}
