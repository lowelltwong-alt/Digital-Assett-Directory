{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dad.local/schemas/technical-product-company-os-registry-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "registry_version", "status", "candidate_only", "ai_agnostic", "authority_boundary", "implemented_scope", "authority_precedence", "decision_rights", "consequence_tiers", "separation_of_duties", "one_human_ops_profile", "retrieval_policy", "telemetry_policy", "automation_policy", "adapter_policy", "offload_policy", "foundation_capabilities", "capabilities", "workflows", "graph_contract", "metric_guards"],
  "properties": {
    "schema_version": {"const": "dad.technical_product_company_os_registry.v1"},
    "registry_id": {"const": "technical-product-company-os-registry"},
    "registry_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["candidate", "reviewed", "active", "retired"]},
    "candidate_only": {"type": "boolean"},
    "ai_agnostic": {"const": true},
    "authority_boundary": {"type": "string", "minLength": 40},
    "implemented_scope": {"type": "object", "required": ["coverage_ranks", "later_ranks_status", "maximum_immediate_decisions", "single_human_operator", "operator_has_external_full_time_job"], "properties": {"coverage_ranks": {"const": [1, 10]}, "later_ranks_status": {"const": "deferred_not_implemented"}, "maximum_immediate_decisions": {"type": "integer", "maximum": 3}, "single_human_operator": {"const": true}, "operator_has_external_full_time_job": {"const": true}}, "additionalProperties": false},
    "authority_precedence": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string"}},
    "decision_rights": {"type": "array", "minItems": 7, "items": {"$ref": "#/$defs/right"}},
    "consequence_tiers": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/tier"}},
    "separation_of_duties": {"type": "object", "minProperties": 7, "additionalProperties": {"const": true}},
    "one_human_ops_profile": {"type": "object", "required": ["profile_id", "maximum_today", "maximum_digest_asks", "maximum_digests_per_workday", "default_interrupt_budget", "normal_weekday_review_minutes", "weekly_review_minutes", "quiet_mode_blocks_model_calls", "quiet_mode_blocks_notifications", "unchanged_cycle_model_tokens", "age_alone_can_escalate", "overflow_policy", "batch_by", "human_decision_actions"], "properties": {"profile_id": {"type": "string"}, "maximum_today": {"type": "integer", "maximum": 3}, "maximum_digest_asks": {"type": "integer", "maximum": 3}, "maximum_digests_per_workday": {"type": "integer", "maximum": 1}, "default_interrupt_budget": {"const": 0}, "normal_weekday_review_minutes": {"type": "integer", "minimum": 1}, "weekly_review_minutes": {"type": "integer", "minimum": 1}, "quiet_mode_blocks_model_calls": {"const": true}, "quiet_mode_blocks_notifications": {"const": true}, "unchanged_cycle_model_tokens": {"const": 0}, "age_alone_can_escalate": {"const": false}, "overflow_policy": {"type": "string"}, "batch_by": {"type": "string"}, "human_decision_actions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}, "additionalProperties": false},
    "retrieval_policy": {"type": "object", "required": ["router_revision", "stages", "semantic_default", "maximum_primary_capabilities", "required_reason_codes", "dependency_and_validator_expansion_required", "held_out_metrics"], "properties": {"router_revision": {"type": "string"}, "stages": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string"}}, "semantic_default": {"type": "string"}, "maximum_primary_capabilities": {"type": "integer", "maximum": 3}, "required_reason_codes": {"const": true}, "dependency_and_validator_expansion_required": {"const": true}, "held_out_metrics": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string"}}}, "additionalProperties": false},
    "telemetry_policy": {"type": "object", "required": ["activation_status", "route_ledger", "run_ledger", "event_identity", "last_used_basis", "operational_counts_exclude_synthetic", "raw_prompts_allowed", "prompt_hashes_allowed", "absolute_paths_allowed", "client_payloads_allowed", "provider_model_ids_in_stable_identity", "unknown_token_usage_is_zero", "corrections_are_append_only"], "properties": {"activation_status": {"const": "explicit_opt_in"}, "route_ledger": {"type": "string"}, "run_ledger": {"type": "string"}, "event_identity": {"const": "source_plus_event_id"}, "last_used_basis": {"type": "string"}, "operational_counts_exclude_synthetic": {"const": true}, "raw_prompts_allowed": {"const": false}, "prompt_hashes_allowed": {"const": false}, "absolute_paths_allowed": {"const": false}, "client_payloads_allowed": {"const": false}, "provider_model_ids_in_stable_identity": {"const": false}, "unknown_token_usage_is_zero": {"const": false}, "corrections_are_append_only": {"const": true}}, "additionalProperties": false},
    "automation_policy": {"type": "object", "required": ["default_status", "activation_ladder", "no_change_behavior", "required_fields", "self_enable_allowed", "instruction_edit_allowed", "notification_default", "external_mutation_default"], "properties": {"default_status": {"const": "dormant"}, "activation_ladder": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string"}}, "no_change_behavior": {"type": "string"}, "required_fields": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "string"}}, "self_enable_allowed": {"const": false}, "instruction_edit_allowed": {"const": false}, "notification_default": {"const": "denied"}, "external_mutation_default": {"const": "denied"}}, "additionalProperties": false},
    "adapter_policy": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/adapter"}},
    "offload_policy": {"type": "object", "required": ["all_eligibility_required", "reject_classes", "packet_fields"], "properties": {"all_eligibility_required": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string"}}, "reject_classes": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string"}}, "packet_fields": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string"}}}, "additionalProperties": false},
    "foundation_capabilities": {"type": "array", "items": {"type": "object", "required": ["capability_id", "implementation_ref"], "properties": {"capability_id": {"type": "string"}, "implementation_ref": {"type": "string"}}, "additionalProperties": false}},
    "capabilities": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/capability"}},
    "workflows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/workflow"}},
    "graph_contract": {"type": "object", "required": ["node_types", "edge_types", "generated_edges_are_candidate", "runtime_cooccurrence_cannot_create_dependency", "graph_edges_cannot_grant_authority"], "properties": {"node_types": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "string"}}, "edge_types": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string"}}, "generated_edges_are_candidate": {"const": true}, "runtime_cooccurrence_cannot_create_dependency": {"const": true}, "graph_edges_cannot_grant_authority": {"const": true}}, "additionalProperties": false},
    "metric_guards": {"type": "object", "minProperties": 10, "additionalProperties": {"type": ["boolean", "string"]}}
  },
  "$defs": {
    "right": {"type": "object", "required": ["right_id", "description", "allowed_actor_classes", "allowed_consequence_tiers", "required_gates", "prohibited_side_effects"], "properties": {"right_id": {"enum": ["observe", "retrieve", "recommend", "draft", "validate", "execute", "prohibited"]}, "description": {"type": "string"}, "allowed_actor_classes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "allowed_consequence_tiers": {"type": "array", "uniqueItems": true, "items": {"enum": ["C0", "C1", "C2", "C3"]}}, "required_gates": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "prohibited_side_effects": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}, "additionalProperties": false},
    "tier": {"type": "object", "required": ["tier", "label", "human_gate", "checker_gate", "lease_required", "final_confirmation_required", "rollback_required", "examples"], "properties": {"tier": {"enum": ["C0", "C1", "C2", "C3", "C4"]}, "label": {"type": "string"}, "human_gate": {"type": "boolean"}, "checker_gate": {"type": "boolean"}, "lease_required": {"type": "boolean"}, "final_confirmation_required": {"type": "boolean"}, "rollback_required": {"type": "boolean"}, "examples": {"type": "array", "minItems": 1, "items": {"type": "string"}}}, "additionalProperties": false},
    "adapter": {"type": "object", "required": ["adapter_id", "adapter_class", "status", "supported_rights", "prohibited_rights", "persistent_capture_allowed", "install_or_global_change_allowed"], "properties": {"adapter_id": {"type": "string", "pattern": "^adapter:"}, "adapter_class": {"type": "string"}, "status": {"enum": ["available", "unavailable_unauthorized", "authorized", "retired"]}, "supported_rights": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "prohibited_rights": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "persistent_capture_allowed": {"const": false}, "install_or_global_change_allowed": {"const": false}}, "additionalProperties": false},
    "capability": {"type": "object", "required": ["capability_id", "coverage_rank", "name", "implementation_kind", "implementation_refs", "depends_on", "validated_by", "trigger_terms"], "properties": {"capability_id": {"type": "string", "pattern": "^capability:"}, "coverage_rank": {"type": "integer", "minimum": 1, "maximum": 10}, "name": {"type": "string"}, "implementation_kind": {"enum": ["orchestration_skill", "existing_family", "new_family", "specialist_pack"]}, "implementation_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^capability:"}}, "validated_by": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "trigger_terms": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string"}}}, "additionalProperties": false},
    "workflow": {"type": "object", "required": ["workflow_id", "revision_id", "status", "trigger_terms", "capability_sequence", "required_human_gates", "validator_refs"], "properties": {"workflow_id": {"type": "string", "pattern": "^workflow:"}, "revision_id": {"type": "string", "pattern": "^workflow-revision:.*:v[1-9][0-9]*$"}, "status": {"enum": ["candidate", "piloted", "reviewed", "active", "retired"]}, "trigger_terms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "capability_sequence": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^capability:"}}, "required_human_gates": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "validator_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}, "additionalProperties": false}
  }
}
