{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.digital-asset-directory/schemas/governance-map-adoption.schema.json",
  "title": "Governance Map Adoption",
  "type": "object",
  "required": [
    "schema_version",
    "repo_id",
    "repo_ref",
    "dad_hub_ref",
    "authority_boundary",
    "source_authority",
    "dad_managed_surfaces",
    "normal_operation_write_boundary",
    "control_planes",
    "validation_commands",
    "human_gates"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "repo_id": {"type": "string", "minLength": 1},
    "repo_ref": {"type": "string", "minLength": 1},
    "dad_hub_ref": {"type": "string", "minLength": 1},
    "authority_boundary": {"type": "string", "minLength": 1},
    "source_authority": {"type": "string", "minLength": 1},
    "agent_runtime_policy": {
      "type": "object",
      "required": [
        "core_contract",
        "adapter_authority",
        "agent_id_policy",
        "vendor_lock_in_prohibited"
      ],
      "properties": {
        "core_contract": {"const": "AGENTS.md"},
        "adapter_authority": {"const": "optional_wrapper_only"},
        "agent_id_policy": {"const": "arbitrary_non_empty_string"},
        "vendor_lock_in_prohibited": {"const": true},
        "internal_integration_default": {"const": "mcp_over_direct_api"},
        "mcp_authority": {"const": "neutral_tool_resource_prompt_boundary"},
        "direct_api_policy": {"const": "external_adapter_fallback_only"},
        "mcp_audit_policy": {"const": "dad_lifecycle_and_audit_required_for_side_effects"}
      },
      "additionalProperties": false
    },
    "dad_managed_surfaces": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "normal_operation_write_boundary": {"const": ".digital-asset/mail/**"},
    "control_planes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "validation_commands": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "human_gates": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
