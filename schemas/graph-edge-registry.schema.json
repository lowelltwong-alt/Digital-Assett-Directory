{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.digital-asset-directory/schemas/graph-edge-registry.schema.json",
  "title": "DAD Graph Edge Registry",
  "description": "Reviewed, closed, versioned vocabulary for generated lesson-graph edges.",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "status", "authority_boundary", "edge_types"],
  "properties": {
    "registry_version": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "authority_boundary": {"type": "string", "minLength": 1},
    "edge_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "edge_type",
          "edge_class",
          "direction",
          "cardinality",
          "semantics",
          "allowed_bases",
          "evidence_required",
          "version",
          "examples",
          "danger_if_wrong",
          "review_status"
        ],
        "properties": {
          "edge_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "edge_class": {"enum": ["join", "inference"]},
          "direction": {"type": "string", "minLength": 1},
          "cardinality": {"type": "string", "minLength": 1},
          "semantics": {"type": "string", "minLength": 1},
          "allowed_bases": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "evidence_required": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "version": {"type": "string", "minLength": 1},
          "examples": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "danger_if_wrong": {"type": "string", "minLength": 1},
          "review_status": {"enum": ["candidate", "reviewed", "deprecated"]}
        }
      }
    }
  }
}
