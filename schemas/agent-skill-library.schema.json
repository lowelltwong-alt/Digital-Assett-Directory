{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.digital-asset-directory/schemas/agent-skill-library.schema.json",
  "title": "Agent Skill Library Registry",
  "type": "object",
  "required": [
    "schema_version",
    "library_version",
    "status",
    "authority_boundary",
    "checkout_policy",
    "skills"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "library_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["candidate_seed", "reviewed", "retired"]},
    "authority_boundary": {"type": "string", "minLength": 1},
    "checkout_policy": {
      "type": "object",
      "required": [
        "default_checkout_mode",
        "allowed_checkout_modes",
        "default_update_channel",
        "downstream_mutation_policy"
      ],
      "properties": {
        "default_checkout_mode": {"enum": ["pointer", "wrapper"]},
        "allowed_checkout_modes": {
          "type": "array",
          "items": {
            "enum": [
              "pointer",
              "wrapper",
              "local_copy_requires_human_approval",
              "plugin_install_manual"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "default_update_channel": {"enum": ["dad_mail", "manual_review", "plugin_release"]},
        "downstream_mutation_policy": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "skill_id",
          "name",
          "version",
          "status",
          "skill_format",
          "path",
          "entrypoint",
          "description",
          "trigger_examples",
          "capabilities",
          "checkout_modes",
          "update_policy",
          "lifecycle",
          "source_evidence",
          "authority_boundary",
          "review_status",
          "last_reviewed_at",
          "next_review_due_at"
        ],
        "properties": {
          "skill_id": {"type": "string", "pattern": "^skill:[a-z0-9][a-z0-9:-]*$"},
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "status": {"enum": ["active", "candidate", "deprecated", "retired", "replaced"]},
          "skill_format": {
            "enum": [
              "codex_skill",
              "claude_skill",
              "cursor_rule",
              "copilot_instruction",
              "generic_agent_skill",
              "plugin_pack",
              "pointer_only"
            ]
          },
          "path": {"type": "string", "minLength": 1},
          "entrypoint": {"type": "string", "minLength": 1},
          "subagent_pack": {"type": "string", "pattern": "^assets/agent-skills/[A-Za-z0-9._/-]+/subagents\\.yaml$"},
          "kernel_compatibility": {
            "type": "object",
            "additionalProperties": false,
            "required": ["contract_ref", "durable_lifecycle_states", "overlay_terms", "unsupported_claims"],
            "properties": {
              "contract_ref": {"type": "string", "minLength": 1},
              "durable_lifecycle_states": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "overlay_terms": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "unsupported_claims": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          },
          "description": {"type": "string", "minLength": 1},
          "trigger_examples": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1
          },
          "does_not_apply_when": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "default": []
          },
          "capabilities": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1,
            "uniqueItems": true
          },
          "checkout_modes": {
            "type": "array",
            "items": {
              "enum": [
                "pointer",
                "wrapper",
                "local_copy_requires_human_approval",
                "plugin_install_manual"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "update_policy": {"enum": ["dad_mail_notice", "manual_review", "plugin_release_notice"]},
          "lifecycle": {
            "type": "object",
            "required": [
              "supersedes",
              "superseded_by",
              "retirement_reason",
              "replacement_skill_id",
              "change_notice_templates"
            ],
            "properties": {
              "supersedes": {"type": "array", "items": {"type": "string"}},
              "superseded_by": {"type": "array", "items": {"type": "string"}},
              "retirement_reason": {"type": "string"},
              "replacement_skill_id": {"type": "string"},
              "change_notice_templates": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              }
            },
            "additionalProperties": false
          },
          "dependencies": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "default": []
          },
          "source_evidence": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1
          },
          "authority_boundary": {"type": "string", "minLength": 1},
          "default_tier": {
            "type": "array",
            "description": "Optional provider-neutral start tiers from config/intelligence-routing-registry.json; advice only.",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]*$"}
          },
          "review_status": {"enum": ["candidate", "reviewed", "rejected"]},
          "last_reviewed_at": {"type": "string", "minLength": 1},
          "next_review_due_at": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

