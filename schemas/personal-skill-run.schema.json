{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://local.digital-asset-directory/schemas/personal-skill-run.schema.json", "title": "Personal Skill Archive Run", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "run_id", "run_kind", "observed_at", "data_root_mode", "source_manifest_id", "source_manifest_sha256", "entries", "unknown_origins", "status", "review_status", "authority_boundary"],
  "properties": {
    "schema_version": {"const": "dad.personal-skills.v1"}, "run_id": {"type": "string", "pattern": "^dad:personal-skill-run:"}, "run_kind": {"const": "snapshot"}, "observed_at": {"type": "string", "minLength": 1}, "data_root_mode": {"enum": ["data_root", "legacy"]}, "source_manifest_id": {"const": "global-personal-skills-gpt"}, "source_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "status": {"enum": ["complete", "needs_review"]}, "review_status": {"const": "candidate_observation"}, "authority_boundary": {"type": "string", "minLength": 1},
    "entries": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["skill_id", "event_type", "observed_at", "run_id", "previous_revision_id", "revision_id", "source_relative_path", "source_runtime", "validation_status", "issues"], "properties": {"skill_id": {"type": "string"}, "event_type": {"enum": ["created", "revised", "unchanged", "missing", "unsafe", "paused", "not_allowlisted"]}, "observed_at": {"type": "string"}, "run_id": {"type": "string"}, "previous_revision_id": {"type": "string"}, "revision_id": {"type": "string"}, "source_relative_path": {"type": "string", "minLength": 1}, "source_runtime": {"type": "string", "minLength": 1}, "validation_status": {"enum": ["safe_snapshot", "blocked_unsafe", "not_observed"]}, "issues": {"type": "array", "items": {"type": "object"}}}}},
    "unknown_origins": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["source_relative_path", "status", "reason"], "properties": {"source_relative_path": {"type": "string"}, "status": {"const": "unknown_origin"}, "reason": {"type": "string"}}}}
  }
}
