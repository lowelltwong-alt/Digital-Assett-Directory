{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.digital-asset-directory/schemas/workflow-part.schema.json",
  "title": "Workflow Part Record",
  "type": "object",
  "required": [
    "schema_version",
    "part_id",
    "part_type",
    "source_asset_ids",
    "asset_pattern_id",
    "role_in_workflow",
    "inputs",
    "outputs",
    "preconditions",
    "postconditions",
    "side_effects",
    "authority_boundary",
    "human_gates",
    "validation_commands",
    "failure_modes",
    "applies_when",
    "does_not_apply_when",
    "danger_if_misapplied",
    "composition_affordances",
    "incompatible_parts",
    "example_workflows",
    "context_tags",
    "maturity",
    "confidence",
    "risk",
    "evidence",
    "methodology_version",
    "generated_at",
    "scan_id",
    "review_status"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "part_id": {"type": "string", "minLength": 1},
    "part_type": {
      "enum": [
        "validator",
        "contract",
        "gate",
        "runner",
        "orchestrator",
        "prompt_part",
        "capability_provider",
        "human_gate",
        "eval_gold",
        "learning_signal",
        "boundary_map",
        "decision_record",
        "lesson_part",
        "calibration_gate",
        "quarantine_gate"
      ]
    },
    "source_asset_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    },
    "asset_pattern_id": {"type": "string", "minLength": 1},
    "role_in_workflow": {"type": "string", "minLength": 1},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "postconditions": {"type": "array", "items": {"type": "string"}},
    "side_effects": {"type": "array", "items": {"type": "string"}},
    "authority_boundary": {"type": "string", "minLength": 1},
    "human_gates": {"type": "array", "items": {"type": "string"}},
    "validation_commands": {"type": "array", "items": {"type": "string"}},
    "failure_modes": {"type": "array", "items": {"type": "string"}},
    "applies_when": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    },
    "does_not_apply_when": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    },
    "danger_if_misapplied": {"type": "string", "minLength": 1},
    "composition_affordances": {"type": "array", "items": {"type": "string"}},
    "incompatible_parts": {"type": "array", "items": {"type": "string"}},
    "example_workflows": {"type": "array", "items": {"type": "string"}},
    "context_tags": {"type": "array", "items": {"type": "string"}},
    "maturity": {"enum": ["recognized", "validated", "reused", "reviewed"]},
    "confidence": {"enum": ["low", "medium", "high"]},
    "risk": {"enum": ["low", "medium", "high"]},
    "evidence": {"type": "object", "minProperties": 1},
    "methodology_version": {"const": "workflow-part-recognition-v1"},
    "generated_at": {"type": "string"},
    "scan_id": {"type": "string", "minLength": 1},
    "review_status": {"enum": ["generated_candidate", "reviewed", "rejected"]}
  },
  "additionalProperties": false
}
