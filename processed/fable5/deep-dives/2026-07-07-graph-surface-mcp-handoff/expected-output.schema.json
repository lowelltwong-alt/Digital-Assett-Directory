{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.digital-asset-directory/schemas/fable5-graph-surface-mcp-handoff-output.schema.json",
  "title": "Fable 5 Graph Surface MCP Handoff Output",
  "type": "object",
  "required": [
    "summary",
    "decisions",
    "answered_questions",
    "kernels",
    "codex_delegations",
    "plan_adjustments",
    "red_team_premortem",
    "risks",
    "status"
  ],
  "properties": {
    "summary": {"type": "string", "minLength": 1},
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["decision_id", "decision", "rationale", "authority_boundary"],
        "properties": {
          "decision_id": {"type": "string", "minLength": 1},
          "decision": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1},
          "authority_boundary": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "answered_questions": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "required": ["question_id", "answer", "implementation_implication"],
        "properties": {
          "question_id": {"type": "string", "minLength": 1},
          "answer": {"type": "string", "minLength": 1},
          "implementation_implication": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "kernels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kernel_id",
          "purpose",
          "files",
          "invariants",
          "tests",
          "validation_commands",
          "do_not_build_yet"
        ],
        "properties": {
          "kernel_id": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "files": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "invariants": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "tests": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "validation_commands": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "do_not_build_yet": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "human_gate_implication": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "codex_delegations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["delegation_id", "priority", "files", "patch_hint", "validation_commands"],
        "properties": {
          "delegation_id": {"type": "string", "minLength": 1},
          "priority": {"enum": ["critical", "high", "medium", "low"]},
          "files": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "patch_hint": {"type": "string", "minLength": 1},
          "validation_commands": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "plan_adjustments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["adjustment_id", "current_plan_step", "recommended_change", "reason"],
        "properties": {
          "adjustment_id": {"type": "string", "minLength": 1},
          "current_plan_step": {"type": "string", "minLength": 1},
          "recommended_change": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "transport_merge_dependency": {"type": "string"},
          "validation_commands": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "red_team_premortem": {
      "type": "object",
      "required": ["red_team_findings", "premortem_failures", "fixes"],
      "properties": {
        "red_team_findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["finding_id", "severity", "attack_or_failure", "guardrail"],
            "properties": {
              "finding_id": {"type": "string", "minLength": 1},
              "severity": {"enum": ["critical", "high", "medium", "low"]},
              "attack_or_failure": {"type": "string", "minLength": 1},
              "guardrail": {"type": "string", "minLength": 1},
              "test_or_validation": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "premortem_failures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["failure_id", "failure", "likely_cause", "prevention"],
            "properties": {
              "failure_id": {"type": "string", "minLength": 1},
              "failure": {"type": "string", "minLength": 1},
              "likely_cause": {"type": "string", "minLength": 1},
              "prevention": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "fixes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["fix_id", "fix", "files", "validation_commands"],
            "properties": {
              "fix_id": {"type": "string", "minLength": 1},
              "fix": {"type": "string", "minLength": 1},
              "files": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "validation_commands": {"type": "array", "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "unresolved_human_questions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "risk", "mitigation"],
        "properties": {
          "severity": {"enum": ["critical", "high", "medium", "low"]},
          "risk": {"type": "string", "minLength": 1},
          "mitigation": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "status": {"enum": ["candidate", "ready_for_codex", "needs_human_review"]}
  },
  "additionalProperties": false
}
