{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.digital-asset-directory/schemas/fable5-deployment-rust-handoff-finding.schema.json",
  "title": "Fable 5 DAD Deployment Rust Handoff Finding",
  "type": "object",
  "required": [
    "finding_id",
    "severity",
    "subsystem",
    "issue",
    "evidence_paths",
    "risk_if_skipped",
    "recommended_action",
    "owner",
    "validation_commands",
    "status"
  ],
  "properties": {
    "finding_id": {"type": "string", "minLength": 1},
    "severity": {"enum": ["critical", "high", "medium", "low"]},
    "subsystem": {"type": "string", "minLength": 1},
    "issue": {"type": "string", "minLength": 1},
    "evidence_paths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    },
    "risk_if_skipped": {"type": "string", "minLength": 1},
    "recommended_action": {"type": "string", "minLength": 1},
    "owner": {"enum": ["fable", "codex", "human", "shared"]},
    "codex_delegation": {
      "type": "object",
      "properties": {
        "files": {"type": "array", "items": {"type": "string"}},
        "patch_hint": {"type": "string"},
        "validation_commands": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "validation_commands": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    },
    "public_private_notes": {"type": "string"},
    "human_gate_implication": {"type": "string"},
    "status": {"enum": ["candidate", "accepted", "deferred", "rejected"]}
  },
  "additionalProperties": false
}
