      "provider",
      "model_id",
      "reasoning_effort",
      "runtime_tools",
      "observed_at",
      "expires_at"
    ],
    "resolution_inputs": [
      "availability",
      "tools",
      "context",
      "privacy",
      "cost",
      "consequence"
    ],
    "fail_closed_rule": "Stop when no approved available runtime can satisfy the same tools, context, privacy, output, evidence, and consequence contract."
  },
  "promotion_policy": {
    "minimum_cross_repo_recurrence": 3,
    "high_consequence_domain_exception": true,
    "required_evidence": [
      "distinct authority boundary",
      "distinct validation harness",
      "distinct freshness sources",
      "distinct failure modes"
    ],
