    {
      "adapter_id": "adapter:cursor-local",
      "adapter_class": "optional_external_worker",
      "status": "unavailable_unauthorized",
      "supported_rights": ["draft"],
      "prohibited_rights": ["retrieve_secrets", "install_plugins", "change_global_settings", "deploy", "merge", "release", "external_mutation", "self_validate"],
      "persistent_capture_allowed": false,
      "install_or_global_change_allowed": false
    }
  ],
  "offload_policy": {
    "all_eligibility_required": ["mechanical_task", "closed_allowed_paths", "stable_authority_and_interfaces", "deterministic_validation", "isolated_worktree", "reversible_diff", "explicit_lease", "independent_checker", "sanitized_minimal_packet"],
    "reject_classes": ["secrets", "permission_expansion", "network_expansion", "dependency_addition", "public_release", "governance_edit", "source_of_truth_edit", "migration", "security_critical_logic", "ambiguous_cross_repo_semantics", "missing_validator"],
    "packet_fields": ["goal", "authority_refs", "allowed_paths", "forbidden_paths", "forbidden_actions", "snapshot_digest", "acceptance", "validation", "budget", "timeout", "checker"]
