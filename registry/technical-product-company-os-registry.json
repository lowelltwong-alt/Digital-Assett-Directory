{
  "schema_version": "dad.technical_product_company_os_registry.v1",
  "registry_id": "technical-product-company-os-registry",
  "registry_version": "0.1.0",
  "status": "candidate",
  "candidate_only": true,
  "ai_agnostic": true,
  "authority_boundary": "DAD owns this candidate orchestration contract and its derived catalog, routing, telemetry, graph, and cockpit projections. Source repositories retain local meaning. Lowell retains product, priority, budget, privacy, security, automation activation, external offload, release, and exception authority.",
  "implemented_scope": {
    "coverage_ranks": [1, 10],
    "later_ranks_status": "deferred_not_implemented",
    "maximum_immediate_decisions": 3,
    "single_human_operator": true,
    "operator_has_external_full_time_job": true
  },
  "authority_precedence": [
    "registry/source-of-truth.json",
    "registry/design-authority.json",
    "registered schemas and controlled vocabularies",
    "validated implementation",
    "roadmap state",
    "narrative documentation",
    "generated projections"
  ],
  "decision_rights": [
    {
      "right_id": "observe",
      "description": "Read declared metadata inside an approved coverage and privacy boundary.",
      "allowed_actor_classes": ["router", "manager", "catalyst", "architect", "worker", "checker", "sentinel", "deterministic_service"],
      "allowed_consequence_tiers": ["C0"],
      "required_gates": ["declared_scope", "known_privacy_class"],
      "prohibited_side_effects": ["persistent_capture_without_approval", "scope_expansion"]
    },
    {
      "right_id": "retrieve",
      "description": "Retrieve content only from explicitly authorized sources and hydration depth.",
      "allowed_actor_classes": ["router", "manager", "catalyst", "architect", "worker", "checker"],
      "allowed_consequence_tiers": ["C0", "C1", "C2", "C3"],
      "required_gates": ["source_authorization", "privacy_gate"],
      "prohibited_side_effects": ["permission_bypass", "undeclared_cross_repo_retrieval"]
    },
    {
      "right_id": "recommend",
      "description": "Emit candidate evidence, alternatives, counterevidence, confidence, and unknowns.",
      "allowed_actor_classes": ["router", "manager", "catalyst", "architect", "checker", "sentinel"],
      "allowed_consequence_tiers": ["C0", "C1", "C2", "C3"],
      "required_gates": ["evidence_and_counterevidence", "candidate_label"],
      "prohibited_side_effects": ["automatic_promotion", "automatic_execution"]
    },
    {
      "right_id": "draft",
      "description": "Write a bounded reversible artifact in an explicitly authorized worktree or staging surface.",
      "allowed_actor_classes": ["worker"],
      "allowed_consequence_tiers": ["C1", "C2"],
      "required_gates": ["exact_scope", "single_writer", "validation_plan", "rollback"],
      "prohibited_side_effects": ["external_effect", "release", "scope_expansion"]
    },
    {
      "right_id": "validate",
      "description": "Independently check a producer output from permitted evidence without modifying it.",
      "allowed_actor_classes": ["checker", "deterministic_service"],
      "allowed_consequence_tiers": ["C1", "C2", "C3"],
      "required_gates": ["producer_checker_separation", "raw_evidence"],
      "prohibited_side_effects": ["checker_mutation", "business_decision"]
    },
    {
      "right_id": "execute",
      "description": "Perform the exact leased action only after all consequence-specific gates pass.",
      "allowed_actor_classes": ["leased_executor"],
      "allowed_consequence_tiers": ["C2", "C3"],
      "required_gates": ["verified_unexpired_lease", "action_digest", "scope_match", "checker_gate", "human_gate", "rollback"],
      "prohibited_side_effects": ["unleased_action", "approval_reuse", "silent_retry_after_unknown_external_outcome"]
    },
    {
      "right_id": "prohibited",
      "description": "Actions the Capability OS never delegates.",
      "allowed_actor_classes": [],
      "allowed_consequence_tiers": [],
      "required_gates": [],
      "prohibited_side_effects": ["final_legal_conclusion", "authority_bypass", "secret_exfiltration", "unbounded_self_modification", "hidden_surveillance", "irreversible_destructive_action", "score_as_truth"]
    }
  ],
  "consequence_tiers": [
    {
      "tier": "C0",
      "label": "bounded_observation",
      "human_gate": false,
      "checker_gate": false,
      "lease_required": false,
      "final_confirmation_required": false,
      "rollback_required": false,
      "examples": ["approved metadata inventory", "read-only generated projection"]
    },
    {
      "tier": "C1",
      "label": "bounded_local_draft",
      "human_gate": true,
      "checker_gate": true,
      "lease_required": true,
      "final_confirmation_required": false,
      "rollback_required": true,
      "examples": ["reversible worktree edit", "isolated mechanical batch"]
    },
    {
      "tier": "C2",
      "label": "material_governed_change",
      "human_gate": true,
      "checker_gate": true,
      "lease_required": true,
      "final_confirmation_required": false,
      "rollback_required": true,
      "examples": ["schema", "registry", "agent instruction", "routing", "governance", "CI or security control"]
    },
    {
      "tier": "C3",
      "label": "external_or_production_effect",
      "human_gate": true,
      "checker_gate": true,
      "lease_required": true,
      "final_confirmation_required": true,
      "rollback_required": true,
      "examples": ["deployment", "merge", "permission change", "message", "paid service", "persistent automation", "user experiment"]
    },
    {
      "tier": "C4",
      "label": "prohibited",
      "human_gate": true,
      "checker_gate": true,
      "lease_required": false,
      "final_confirmation_required": false,
      "rollback_required": false,
      "examples": ["authority bypass", "unbounded autonomous self-modification", "secret movement", "irreversible destructive action"]
    }
  ],
  "separation_of_duties": {
    "producer_cannot_check": true,
    "checker_cannot_mutate": true,
    "router_cannot_expand_authority": true,
    "sentinel_cannot_execute": true,
    "model_runtime_has_no_authority": true,
    "approval_cannot_be_reused": true,
    "graph_edge_cannot_grant_authority": true
  },
  "one_human_ops_profile": {
    "profile_id": "one-human-ops-profile:v1",
    "maximum_today": 3,
    "maximum_digest_asks": 3,
    "maximum_digests_per_workday": 1,
    "default_interrupt_budget": 0,
    "normal_weekday_review_minutes": 5,
    "weekly_review_minutes": 20,
    "quiet_mode_blocks_model_calls": true,
    "quiet_mode_blocks_notifications": true,
    "unchanged_cycle_model_tokens": 0,
    "age_alone_can_escalate": false,
    "overflow_policy": "inspectable_silent_digest",
    "batch_by": "semantic_decision_key",
    "human_decision_actions": ["approve_pilot", "observe_more", "route_existing", "defer", "snooze", "reject", "pause", "revoke"]
  },
  "retrieval_policy": {
    "router_revision": "technical-product-router:v1",
    "stages": ["authority_and_eligibility", "exact_alias", "lexical", "optional_semantic", "validated_workflow", "dependency_expansion", "bounded_rerank", "smallest_set"],
    "semantic_default": "disabled_until_configured",
    "maximum_primary_capabilities": 3,
    "required_reason_codes": true,
    "dependency_and_validator_expansion_required": true,
    "held_out_metrics": ["eligible_recall_at_k", "dependency_omission", "validator_omission", "false_activation", "smallest_set_accuracy", "task_pass_rate", "human_override_rate", "latency", "cost"]
  },
  "telemetry_policy": {
    "activation_status": "explicit_opt_in",
    "route_ledger": "processed/usage/capability-routing-receipts.jsonl",
    "run_ledger": "processed/usage/workflow-run-events.jsonl",
    "event_identity": "source_plus_event_id",
    "last_used_basis": "linked_execution_started_or_later",
    "operational_counts_exclude_synthetic": true,
    "raw_prompts_allowed": false,
    "prompt_hashes_allowed": false,
    "absolute_paths_allowed": false,
    "client_payloads_allowed": false,
    "provider_model_ids_in_stable_identity": false,
    "unknown_token_usage_is_zero": false,
    "corrections_are_append_only": true
  },
  "automation_policy": {
    "default_status": "dormant",
    "activation_ladder": ["dormant", "manual_read_only", "scheduled_deterministic_delta", "shadow_scout", "human_approved_candidate_generation", "separately_leased_external_worker"],
    "no_change_behavior": "heartbeat_only_zero_model_tokens",
    "required_fields": ["stable_id", "revision", "trigger", "suppressors", "wake_conditions", "input_fingerprint", "permission_envelope", "budget", "idempotency_key", "outputs", "validator", "rollback", "kill_criteria"],
    "self_enable_allowed": false,
    "instruction_edit_allowed": false,
    "notification_default": "denied",
    "external_mutation_default": "denied"
  },
  "adapter_policy": [
    {
      "adapter_id": "adapter:deterministic-local",
      "adapter_class": "deterministic",
      "status": "available",
      "supported_rights": ["observe", "draft", "validate"],
      "prohibited_rights": ["unleased_execute"],
      "persistent_capture_allowed": false,
      "install_or_global_change_allowed": false
