{
  "registry_version": "0.1.0",
  "status": "candidate",
  "authority_boundary": "Graph surfaces are named, registered, generated projections. This registry defines their allowed shape and freshness policy; generated graph content remains candidate evidence and cannot override reviewed registries, schemas, AGENTS.md, DAD lifecycle commands, audit records, Git/CI gates, or human approval gates.",
  "surfaces": [
    {
      "surface_id": "lesson-graph",
      "surface_kind": "generated_graph_surface",
      "ontology_id": "knowledge",
      "status": "active",
      "purpose": "Compile lessons, repos, patterns, offerings, and usage rows into a candidate review graph.",
      "builder": {
        "availability": "wired",
        "command": "asset-dir lesson graph",
        "module": "digital_asset_directory.learning.build_lesson_graph"
      },
      "source_inputs": [
        {"kind": "data_surface", "ref": "raw_lessons", "required": false},
        {"kind": "data_surface", "ref": "usage", "required": false},
        {"kind": "registry_path", "ref": "registry/asset-pattern-registry.json", "required": true},
        {"kind": "registry_path", "ref": "registry/dad-offerings-registry.json", "required": true},
        {"kind": "registry_path", "ref": "registry/graph-edge-registry.json", "required": true}
      ],
      "outputs": {
        "manifest_logical_path": "learning/lesson-graph-manifest.json",
        "body_logical_path": "learning/lesson-graph.json"
      },
      "schema_refs": [
        "schemas/lesson-graph.schema.json",
        "schemas/graph-surface-manifest.schema.json"
      ],
      "freshness_policy": {
        "fresh": "hashes_match",
        "stale": "warn",
        "inconsistent": "block"
      },
      "consumers": ["DAD validation", "future local MCP read-only surface"],
      "review_status": "candidate",
      "authority_boundary": "Lesson graph rows are candidate review evidence. They do not prove source truth, repo authority, asset value, approval, trust, or recommendation."
    },
    {
      "surface_id": "graph-inference-overlay",
