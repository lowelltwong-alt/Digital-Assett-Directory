  "routing_rules": [
    {
      "when": "source custody, OCR, page inventory, photo text, or visual evidence promotion changes",
      "primary_role_id": "lake_alice_source_custodian",
      "support_role_ids": [
        "gatorade_text_lab"
      ],
      "effort": "high"
    },
    {
      "when": "artifact splitting, normalization, chunking, tables, punctuation, or retrieval checks change",
      "primary_role_id": "gatorade_text_lab",
      "support_role_ids": [
        "lake_alice_source_custodian"
      ],
      "effort": "medium"
    },
    {
      "when": "human witness packet, witness knowledge, exhibit familiarity, role alignment, or timeline perspective changes",
      "primary_role_id": "alberta_witness_boundary_coach",
      "support_role_ids": [
        "tebow_15_pressure_drill_coach",
        "wuerffel_7_integrity_reviewer"
      ],
      "effort": "high"
    },
    {
      "when": "witness-prep podcast, NotebookLM production packet, script voice, study guide, or learning design changes",
      "primary_role_id": "petty_wildflowers_script_editor",
      "support_role_ids": [
        "alberta_witness_boundary_coach",
        "faye_dialogue_craft_reviewer"
      ],
      "effort": "medium"
    },
    {
      "when": "attorney tactics, scenario sweeps, simulation controls, Monte Carlo, VVUQ, sensitivity, or calibration changes",
      "primary_role_id": "spurrier_11_playbook_simulator",
      "support_role_ids": [
        "sagan_vvuq_scout",
        "tebow_15_pressure_drill_coach"
      ],
      "effort": "high"
    },
    {
      "when": "output package completeness, print/send readiness, output selection, or final artifact manifest changes",
      "primary_role_id": "smith_22_output_finisher",
      "support_role_ids": [
        "albert_general_orchestrator",
        "wuerffel_7_integrity_reviewer"
      ],
      "effort": "medium"
    },
    {
      "when": "UI workflow, control plane, output selection, or MCP route boundary changes",
      "primary_role_id": "century_tower_control_plane_reviewer",
      "support_role_ids": [
        "bob_graham_governance_reviewer"
      ],
      "effort": "medium"
    },
    {
      "when": "privacy, privilege, Microsoft/Fabric/Copilot, export, security, real-case readiness, or deployment changes",
      "primary_role_id": "bob_graham_governance_reviewer",
      "support_role_ids": [
        "century_tower_control_plane_reviewer"
      ],
      "effort": "high"
    },
    {
      "when": "reusable lesson, DAD handoff, asset catalog, or cross-repo workflow memory changes",
      "primary_role_id": "century_tower_dad_cartographer",
      "support_role_ids": [
        "albert_general_orchestrator"
      ],
      "effort": "low"
    }
  ],
  "decision_surfaces": [
    {
      "surface_id": "ocr_to_markdown",
      "required_artifacts": [
        "page_inventory",
        "extraction_records",
        "whole_packet_extraction_ledger",
        "ocr_visual_review_queue",
        "artifact_level_normalized_markdown"
      ],
      "promotion_boundary": "whole_packet_extraction_ledger is review-only; artifact-level normalized Markdown feeds chunks and graph"
    },
    {
      "surface_id": "photo_understanding",
      "required_artifacts": [
        "source_observation_layer",
        "analysis_relevance_layer",
        "human_review_status"
      ],
      "promotion_boundary": "analysis/relevance remains counsel-admin-only until reviewed"
    },
    {
      "surface_id": "human_witness_packets",
      "required_artifacts": [
        "separate_markdown_packet_per_human_witness",
        "witness_knows_cannot_know",
        "witness_perspective_timeline",
        "ten_questions_must_get_right",
        "exhibit_familiarity",
        "technique_controls",
        "integrity_review"
      ],
      "promotion_boundary": "evidence-only people do not get standalone witness packets"
    },
    {
      "surface_id": "simulation_and_scenario_sweep",
      "required_artifacts": [
        "strategy_controls",
        "source_bound_answers",
        "score_formula_explanations",
        "sensitivity_watchlist",
        "no_overclaim_language"
      ],
      "promotion_boundary": "heuristic review support only; no jury/verdict prediction or real-case readiness claim"
    }
  ],
  "validation_commands": [
    "python scripts/validate_albert_subagent_decision_flow.py",
    "python scripts/validate_mcp_first_app_architecture.py",
    "python scripts/validate_system_maps.py",
    "python ai_workland/scripts/validate_ai_docs.py",
    "python tools/validate_package.py"
  ]
}
