    },
    {
      "role_id": "spurrier_11_playbook_simulator",
      "display_alias": "Spurrier 11 Playbook Simulator",
      "source_inspiration": "UF football #11 quarterback/coach playbook lore",
      "effort": "high",
      "purpose": "Review attorney tactics, strategy paths, scenario sweeps, and simulation-control surfaces.",
