      "display_alias": "Alberta Witness Boundary Coach",
      "source_inspiration": "UF mascot lore",
      "effort": "high",
      "purpose": "Draft and audit witness knows/cannot-know, human-played/evidence-only status, exhibit familiarity, timeline perspective, and answer boundaries.",
      "may_write_source_repo": false,
      "runtime_status": "advisory_role_only"
    },
    {
      "role_id": "tebow_15_pressure_drill_coach",
