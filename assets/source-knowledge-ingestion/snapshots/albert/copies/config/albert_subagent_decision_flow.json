{
  "schema": "albert_subagent_decision_flow.v1",
  "status": "model_agnostic_advisory_roles_no_runtime",
  "stable_rule": "role_id is the machine contract; display_alias is an internal UF/Gator-themed mnemonic only; Alberta is preferred for Albert-related witness boundaries; football-player aliases include jersey numbers and must not use Hernandez",
  "ai_decisions_are_source_truth": false,
  "human_review_required_for_high_effort": true,
  "mcp_runtime_enabled": false,
  "effort_tiers": {
    "low": {
      "description": "Mechanical, manifest, route, stale-doc, or DAD pointer work that validators can fully check.",
      "human_review_default": false
    },
    "medium": {
      "description": "Judgment-light drafting such as intake proposals, UI workflow review, public fixture scope, or podcast craft review.",
      "human_review_default": true
    },
    "high": {
      "description": "OCR/source promotion, photo relevance, witness knowledge, strategy/simulation, math/VVUQ, ethics, security, privacy, export, or real-case readiness.",
      "human_review_default": true
    }
  },
  "execution_efficiency_policy": {
    "objective": "minimize total model tokens and cost while preserving deterministic evidence, legal boundaries, and independent quality checks",
    "default_route_order": [
      "python_or_rust_script",
      "cached_deterministic_result",
      "cursor_or_cheap_local_batch_worker",
      "luna_low",
      "terra_medium",
      "terra_high",
      "sol_high",
      "sol_extra_high_with_human_approval"
    ],
    "script_first_task_classes": [
      "file_inventory",
      "hashing_and_manifest_generation",
      "schema_validation",
      "fixture_expansion",
      "deterministic_replay",
      "format_conversion",
      "exact_search_and_deduplication",
      "bulk_test_execution",
      "metric_aggregation",
      "visual_snapshot_generation"
    ],
    "cursor_or_cheap_batch_candidate_classes": [
      "large_mechanical_refactor_with_tests",
      "exhaustive_fixture_matrix",
      "long_running_browser_or_qa_battery",
      "bulk_report_regeneration",
      "bounded_repository_inventory"
    ],
    "frontier_model_allowed_when": [
      "architecture_or_contract_design",
      "ambiguous_cross_document_reasoning",
      "legal_or_witness_boundary_judgment",
      "security_privacy_or_source_authority_risk",
      "novel_root_cause_after_deterministic_failure",
      "independent_quality_adjudication"
    ],
    "model_call_preflight": [
      "define_machine_checkable_acceptance",
      "deduplicate_against_prior_hash_and_result",
      "send_minimum_bounded_context_or_summary",
      "exclude_raw_private_or_cross_case_payloads",
      "record_intended_route_and_stop_condition"
    ],
    "default_limits": {
      "fanout": 1,
      "implementation_attempts_before_replan": 1,
      "independent_checkers": 1,
      "max_context_artifacts": 12,
      "extra_high_requires_named_human_approval": true
    },
    "escalation_triggers": [
      "deterministic_validator_failure_requires_judgment",
      "material_worker_checker_disagreement",
      "legal_security_privacy_or_source_authority_risk",
      "cheaper_route_cannot_meet_acceptance_evidence"
    ],
    "prohibited_waste_patterns": [
      "frontier_model_for_command_replay_or_inventory",
      "repeated_full_context_when_hash_or_summary_is_sufficient",
      "parallel_agents_with_duplicate_scope",
      "rerun_unchanged_expensive_stage_without_new_evidence",
      "model_generation_where_rules_or_search_are_equivalent"
    ],
    "cursor_boundary": "Cursor may execute approved deterministic or mechanically reviewable batches using synthetic/public green-only data; it receives a bounded prompt, exact commands, acceptance checks, output paths, and stop conditions. Cursor execution does not waive human, source, privacy, or legal gates.",
    "runtime_status": "routing_contract_only_no_model_or_cursor_runtime_enabled"
  },
  "required_decision_fields": [
    "decision_id",
    "role_id",
    "executor_metadata",
    "evidence_refs",
    "source_or_artifact_refs",
    "confidence",
    "review_status",
    "downstream_effects",
    "wrong_if",
    "human_admin_review_required"
  ],
  "roles": [
    {
      "role_id": "albert_general_orchestrator",
      "display_alias": "Albert General Orchestrator",
      "source_inspiration": "UF mascot lore",
      "effort": "medium",
      "purpose": "Coordinate workflow, read front doors, run validators, and delegate hard calls.",
      "may_write_source_repo": false,
      "runtime_status": "advisory_role_only"
    },
    {
      "role_id": "lake_alice_source_custodian",
      "display_alias": "Lake Alice Source Custodian",
      "source_inspiration": "UF campus lore",
      "effort": "high",
      "purpose": "Protect raw source, OCR/page inventory, photo text, source-fidelity, and promotion gates.",
      "may_write_source_repo": false,
      "runtime_status": "advisory_role_only"
    },
    {
      "role_id": "gatorade_text_lab",
