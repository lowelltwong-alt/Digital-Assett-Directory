{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dad.local/schemas/task-local-agent-mesh-manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "mesh_id", "task_id", "revision_id", "phase", "status",
    "source_snapshot_digest", "authority", "max_delegation_depth",
    "writer_role_id", "checker_role_id", "non_overlap_statement", "roles",
    "proof_obligations", "unresolved_decisions", "manifest_digest"
  ],
  "properties": {
    "schema_version": {"const": "dad.task_local_agent_mesh_manifest.v1"},
    "mesh_id": {"type": "string", "pattern": "^dad:agent-mesh:[a-z0-9][a-z0-9-]*$"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "revision_id": {"type": "string", "pattern": "^dad:agent-mesh-revision:[a-z0-9][a-z0-9-]*:v[1-9][0-9]*$"},
    "supersedes_revision_id": {"type": "string", "pattern": "^dad:agent-mesh-revision:[a-z0-9][a-z0-9-]*:v[1-9][0-9]*$"},
    "phase": {"enum": ["planning", "execution", "postflight"]},
    "status": {"enum": ["planned", "active", "blocked", "complete", "aborted"]},
    "source_snapshot_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_authority", "execution_authority", "human_gate_required"],
      "properties": {
        "source_authority": {"type": "string", "minLength": 1},
        "execution_authority": {"const": false},
        "human_gate_required": {"const": true}
      }
    },
    "max_delegation_depth": {"const": 1},
    "writer_role_id": {"$ref": "#/$defs/roleId"},
    "checker_role_id": {"$ref": "#/$defs/roleId"},
    "non_overlap_statement": {"type": "string", "minLength": 1},
    "roles": {
      "type": "array", "minItems": 2,
      "items": {"$ref": "#/$defs/role"}
    },
    "proof_obligations": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/proofObligation"}
    },
    "unresolved_decisions": {
      "type": "array",
      "items": {"$ref": "#/$defs/unresolvedDecision"}
    },
    "reconciliations": {
      "type": "array",
      "items": {"$ref": "#/$defs/reconciliation"}
    },
    "manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "roleId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "nonEmptyStrings": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "handoff": {
      "type": "object", "additionalProperties": false,
      "required": ["recipient_role_ids", "deliverables", "readiness_conditions"],
      "properties": {
        "recipient_role_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/roleId"}},
        "deliverables": {"$ref": "#/$defs/nonEmptyStrings"},
        "readiness_conditions": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "role": {
      "type": "object", "additionalProperties": false,
      "required": [
        "role_id", "why_needed", "mission", "inputs", "dependencies",
        "authority", "model_effort_class", "writer_checker_relation",
        "acceptance_conditions", "stop_conditions", "handoff"
      ],
      "properties": {
        "role_id": {"$ref": "#/$defs/roleId"},
        "why_needed": {"type": "string", "minLength": 1},
        "mission": {"type": "string", "minLength": 1},
        "inputs": {"$ref": "#/$defs/nonEmptyStrings"},
        "dependencies": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/roleId"}},
        "authority": {"type": "string", "minLength": 1},
        "model_effort_class": {"enum": ["deterministic", "low", "medium", "high", "frontier_manual"]},
        "writer_checker_relation": {"enum": ["writer", "checker", "peer", "specialist"]},
        "acceptance_conditions": {"$ref": "#/$defs/nonEmptyStrings"},
        "stop_conditions": {"$ref": "#/$defs/nonEmptyStrings"},
        "handoff": {"$ref": "#/$defs/handoff"}
      }
    },
    "proofObligation": {
      "type": "object", "additionalProperties": false,
      "required": ["obligation_id", "description", "evidence_required", "owner_role_id", "checker_role_id", "status"],
      "properties": {
        "obligation_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "description": {"type": "string", "minLength": 1},
        "evidence_required": {"$ref": "#/$defs/nonEmptyStrings"},
        "owner_role_id": {"$ref": "#/$defs/roleId"},
        "checker_role_id": {"$ref": "#/$defs/roleId"},
        "status": {"enum": ["pending", "satisfied", "failed", "waived"]}
      }
    },
    "unresolvedDecision": {
      "type": "object", "additionalProperties": false,
      "required": ["decision_id", "summary", "owner_role_id", "blocking", "status"],
      "properties": {
        "decision_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "summary": {"type": "string", "minLength": 1},
        "owner_role_id": {"$ref": "#/$defs/roleId"},
        "blocking": {"type": "boolean"},
        "status": {"enum": ["open", "resolved", "deferred"]}
      }
    },
    "reconciliation": {
      "type": "object", "additionalProperties": false,
      "required": ["disposition", "current_role_ids", "reason", "evidence_refs", "material_drift"],
      "properties": {
        "prior_role_id": {"$ref": "#/$defs/roleId"},
        "disposition": {"enum": ["reused", "replaced", "split", "added", "removed", "blocked"]},
        "current_role_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/roleId"}},
        "reason": {"type": "string", "minLength": 1},
        "evidence_refs": {"$ref": "#/$defs/nonEmptyStrings"},
        "material_drift": {"type": "boolean"}
      }
    }
  }
}
